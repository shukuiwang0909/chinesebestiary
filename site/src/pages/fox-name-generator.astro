---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SubscribeBand from '../components/SubscribeBand.astro';
import { getCreatureImage } from '../utils/creatureImage';

const CATEGORY_LABELS: Record<string, string> = {
  divine_beast: 'Divine Beast',
  fierce_beast: 'Fierce Beast',
  auspicious_beast: 'Auspicious Beast',
  deity: 'Deity',
  strange_being: 'Strange Being',
  hybrid: 'Hybrid',
};

const beasts = (await getCollection('creatures')).map(c => ({
  slug: c.data.id,
  en: c.data.name.en,
  zh: c.data.name.zh_cn,
  pinyin: c.data.name.pinyin,
  element: c.data.taxonomy.element,
  category: c.data.taxonomy.category,
  categoryLabel: CATEGORY_LABELS[c.data.taxonomy.category] ?? c.data.taxonomy.category,
  image: getCreatureImage(c.data.id),
}));

const title = 'Chinese Fox Spirit Name Generator — Huli Jing & Nine-Tailed Fox Names';
const description = 'Generate an authentic Chinese fox spirit name (狐仙名): fox-clan surnames, enchanting spirit epithets, tail count from one to nine — and a guardian beast drawn from the Classic of Mountains and Seas.';
---

<Base title={title} description={description} image="/images/creatures/nine-tailed-fox.jpg">
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is a huli jing (狐狸精)?",
        "acceptedAnswer": { "@type": "Answer", "text": "A huli jing is a fox spirit in Chinese mythology — a fox that has lived long enough to cultivate spiritual power, take human form, and move freely between the mortal and spirit worlds. The more tails a fox spirit has (up to nine), the older and more powerful it is. The nine-tailed fox (九尾狐) appears in the Classic of Mountains and Seas as an omen of peace, and in later folklore as a shape-shifting enchantress." }
      },
      {
        "@type": "Question",
        "name": "What do the tail counts mean?",
        "acceptedAnswer": { "@type": "Answer", "text": "In Chinese fox spirit mythology, a fox gains a new tail every time it achieves a major spiritual breakthrough. A one-tailed fox (一尾) has just awakened; a nine-tailed fox (九尾) has survived 10,000 years and achieved immortality. The system appears in the Classic of Mountains and Seas, the Shan Hai Jing Illustrated, and is a cornerstone of wuxia and xianxia fiction." }
      },
      {
        "@type": "Question",
        "name": "Why do so many fox spirits have the surname Hu (胡)?",
        "acceptedAnswer": { "@type": "Answer", "text": "胡 (Hú) is a pun on 狐 (hú, fox) — different character, same sound. Chinese folklore gave fox spirits the surname Hu so they could pass as human while keeping a hint of their nature. Other common surnames for fox spirits include 苗 (Miáo, seedling/herb — tied to their medicinal plant knowledge) and 林 (Lín, forest — tied to their woodland origins)." }
      },
      {
        "@type": "Question",
        "name": "Can I use a generated name in my novel or game?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. Every component is built from public-domain classical vocabulary. Individual names are not copyrightable. Use them freely for characters, usernames, or fantasy settings." }
      }
    ]
  })} />

  <h2>Fox Spirit Name Generator <span class="zh">狐仙名生成器</span></h2>

  <p class="lede">Generate an authentic <strong>huli jing (狐狸精)</strong> name in the classical style: a mortal alias that conceals the fox within, or a spirit name that declares it openly — with tail count, five-element affinity, and a guardian beast drawn from the 4th-century BCE <em>Shanhaijing</em>.</p>

  <div class="generator">
    <div class="controls">
      <label>
        Element <span class="zh">五行</span>
        <select id="fox-element">
          <option value="any">Fate decides</option>
          <option value="fire">Fire 火</option>
          <option value="water">Water 水</option>
          <option value="wood">Wood 木</option>
          <option value="metal">Metal 金</option>
          <option value="earth">Earth 土</option>
          <option value="wind">Wind 风</option>
          <option value="thunder">Thunder 雷</option>
        </select>
      </label>
      <button id="gen-btn" class="forge-btn" type="button">Reveal My Name <span class="zh">现形</span></button>
    </div>

    <div class="result" id="gen-result" hidden>
      <div class="result-main">
        <div class="seal" aria-hidden="true">狐</div>
        <div class="result-name-block">
          <div class="result-zh zh" id="r-zh">—</div>
          <div class="result-pinyin" id="r-pinyin"></div>
          <div class="result-gloss" id="r-gloss"></div>
        </div>
      </div>
      <dl class="result-meta">
        <div><dt>Tails</dt><dd id="r-tails"></dd></div>
        <div><dt>Element</dt><dd id="r-element"></dd></div>
      </dl>
      <div class="guardian" id="r-guardian"></div>
      <div class="result-actions">
        <button id="copy-btn" class="ghost-btn" type="button">Copy result</button>
        <button id="again-btn" class="ghost-btn" type="button">Reveal again</button>
      </div>
    </div>

    <div class="history" id="gen-history" hidden>
      <h3>Previous names <span class="zh">前世</span></h3>
      <ul id="history-list"></ul>
    </div>
  </div>

  <h3>How fox spirit names work <span class="zh">狐仙取名之道</span></h3>
  <p>Fox spirit names come in two registers. A <strong>mortal alias</strong> (化名) is a normal Chinese name chosen to pass undetected — the surname 胡 is a deliberate pun on 狐 (fox), a wink hidden in plain sight. A <strong>spirit name</strong> (仙号) is what a fox spirit is called in the spirit world: an epithet that captures their power or nature — Nine-Tailed (九尾), Phantom (幻影), City-Overturning Beauty (倾城) — plus a title that declares their rank.</p>
  <p>The tail count is the calendar of fox spirit age. In the <em>Shanhaijing</em>, the nine-tailed fox appears as an auspicious omen at the founding of the Xia dynasty. Later traditions codified the nine-level system: a fox gains a tail at each spiritual breakthrough, with nine tails marking 10,000 years and full immortality. Choose an element, and one of the original beasts of the classic will stand as your guardian.</p>

  <p class="creature-cta">Explore the full mythology of the Nine-Tailed Fox: <a href="/creatures/nine-tailed-fox/">Nine-Tailed Fox 九尾狐 →</a></p>

  <h3>FAQ</h3>
  <details>
    <summary>What is a huli jing (狐狸精)?</summary>
    <p>A fox that has cultivated enough spiritual power to take human form and move between worlds. The more tails, the older and more powerful. Nine tails marks immortality.</p>
  </details>
  <details>
    <summary>What do the tail counts mean?</summary>
    <p>One tail: just awakened (100 years). Three tails: can hold human form (500 years). Five tails: enchanting spirit (1,000 years). Seven tails: ancient fox (3,000 years). Nine tails: heaven fox, immortal (10,000 years).</p>
  </details>
  <details>
    <summary>Can I use a generated name in my novel or game?</summary>
    <p>Yes. Every component is from public-domain classical vocabulary. Names are not copyrightable. Use freely in fiction, games, or usernames.</p>
  </details>

  <SubscribeBand />
</Base>

<script type="application/json" id="gen-data" set:html={JSON.stringify({ beasts })}></script>

<script is:inline>
(function () {
  var data = JSON.parse(document.getElementById('gen-data').textContent);
  var beasts = data.beasts;

  var FOX_SURNAMES = [
    ['胡', 'Hú', 'Fox Clan'],
    ['苗', 'Miáo', 'Herb-Keeper'],
    ['霍', 'Huò', 'Swift'],
    ['林', 'Lín', 'Forest'],
    ['冯', 'Féng', 'Galloping'],
    ['韩', 'Hán', 'Ancient State'],
    ['邵', 'Shào', 'Noble'],
    ['墨', 'Mò', 'Ink'],
  ];

  var FOX_GIVEN = [
    ['清泠', 'Qīnglíng', 'Cool Clarity'],
    ['月华', 'Yuèhuá', 'Moonlight'],
    ['媚儿', 'Mèi\'ér', 'Enchanting One'],
    ['灵犀', 'Língxī', 'Spiritual Intuition'],
    ['梦烟', 'Mèngyān', 'Dream Smoke'],
    ['莺歌', 'Yīnggē', 'Oriole Song'],
    ['素素', 'Sùsù', 'Pure One'],
    ['紫菱', 'Zǐlíng', 'Purple Water-chestnut'],
    ['秋水', 'Qiūshuǐ', 'Autumn Water'],
    ['玉烟', 'Yùyān', 'Jade Smoke'],
    ['雪衣', 'Xuěyī', 'Snow Garment'],
    ['幽兰', 'Yōulán', 'Hidden Orchid'],
  ];

  var FOX_TITLES = [
    ['娘', 'Niáng', 'Lady'],
    ['姬', 'Jī', 'Noble Lady'],
    ['仙', 'Xiān', 'Immortal'],
    ['君', 'Jūn', 'Lord'],
    ['媛', 'Yuàn', 'Gracious One'],
    ['灵', 'Líng', 'Spirit'],
  ];

  var FOX_EPITHETS = [
    ['九尾', 'Jiǔwěi', 'Nine-Tailed', 'nine-tailed-fox'],
    ['三花', 'Sānhuā', 'Three-Blossom', 'nine-tailed-fox'],
    ['幻影', 'Huànyǐng', 'Phantom', null],
    ['摄魂', 'Shèhún', 'Soul-Seizing', null],
    ['倾城', 'Qīngchéng', 'City-Overturning', null],
    ['惑心', 'Huòxīn', 'Heart-Bewitching', null],
    ['媚骨', 'Mèigǔ', 'Bone-Enchanting', null],
    ['玄狐', 'Xuánhú', 'Shadowed Fox', null],
    ['清灵', 'Qīnglíng', 'Pure Spirit', null],
    ['幽魅', 'Yōumèi', 'Night Enchantress', null],
    ['千岁', 'Qiānsuì', 'Thousand Years', null],
    ['流光', 'Liúguāng', 'Flowing Light', null],
  ];

  var FOX_TAILS = [
    ['一尾', 'Yī Wěi', 'Newly Awakened Fox', '100 years'],
    ['二尾', 'Èr Wěi', 'Shaping Illusions', '300 years'],
    ['三尾', 'Sān Wěi', 'Trickster Fox', '500 years'],
    ['五尾', 'Wǔ Wěi', 'Enchanting Spirit', '1,000 years'],
    ['七尾', 'Qī Wěi', 'Ancient Fox', '3,000 years'],
    ['九尾', 'Jiǔ Wěi', 'Heaven Fox — Immortal', '10,000 years'],
  ];

  var ELEMENTS = { fire: 'Fire 火', water: 'Water 水', wood: 'Wood 木', metal: 'Metal 金', earth: 'Earth 土', wind: 'Wind 风', thunder: 'Thunder 雷' };

  function pick(arr) { return arr[Math.floor(Math.random() * arr.length)]; }

  function generate() {
    var elementId = document.getElementById('fox-element').value;

    var nameZh, namePy, gloss;
    var beastSlug = null;

    if (Math.random() < 0.35) {
      var s = pick(FOX_SURNAMES), g = pick(FOX_GIVEN);
      nameZh = s[0] + g[0];
      namePy = s[1] + ' ' + g[1];
      gloss = '(' + s[2] + ' clan) ' + g[2];
    } else {
      var ep = pick(FOX_EPITHETS);
      var ti = pick(FOX_TITLES);
      nameZh = ep[0] + ti[0];
      namePy = ep[1] + ' ' + ti[1];
      gloss = ep[2] + ' ' + ti[2];
      beastSlug = ep[3];
    }

    var tails = pick(FOX_TAILS);

    var element = elementId;
    if (element === 'any') {
      var pool = beasts.filter(function (b) { return b.element !== 'none'; });
      element = pool.length ? pick(pool).element : 'fire';
    }

    var nineTailedFox = beasts.find(function (b) { return b.slug === 'nine-tailed-fox'; });
    var guardians = beasts.filter(function (b) { return b.element === element; });

    var guardian;
    if (beastSlug) {
      guardian = beasts.find(function (b) { return b.slug === beastSlug; })
        || nineTailedFox || pick(beasts);
    } else if (Math.random() < 0.65 && nineTailedFox) {
      guardian = nineTailedFox;
    } else {
      guardian = guardians.length ? pick(guardians) : (nineTailedFox || pick(beasts));
    }

    return {
      zh: nameZh, pinyin: namePy, gloss: gloss,
      tails: tails, element: ELEMENTS[element] || element,
      guardian: guardian
    };
  }

  var history = [];

  function render(r) {
    document.getElementById('r-zh').textContent = r.zh;
    document.getElementById('r-pinyin').textContent = r.pinyin;
    document.getElementById('r-gloss').textContent = r.gloss;
    document.getElementById('r-tails').textContent = r.tails[0] + ' — ' + r.tails[2] + ' (' + r.tails[3] + ')';
    document.getElementById('r-element').textContent = r.element;

    var g = r.guardian;
    var el = document.getElementById('r-guardian');
    el.innerHTML = '';
    var card = document.createElement('a');
    card.href = '/creatures/' + g.slug + '/';
    card.className = 'guardian-card';
    if (g.image) {
      var img = document.createElement('img');
      img.src = g.image;
      img.alt = g.en;
      img.width = 72; img.height = 72;
      card.appendChild(img);
    }
    var info = document.createElement('div');
    info.className = 'guardian-info';
    var t1 = document.createElement('div');
    t1.className = 'guardian-name';
    t1.innerHTML = 'Guardian beast: <strong>' + g.en + ' <span class="zh">' + g.zh + '</span></strong>';
    var t2 = document.createElement('div');
    t2.className = 'guardian-sub';
    t2.textContent = g.categoryLabel + ' · ' + g.pinyin;
    var t3 = document.createElement('div');
    t3.className = 'guardian-link';
    t3.textContent = 'Read its original Shanhaijing entry →';
    info.appendChild(t1); info.appendChild(t2); info.appendChild(t3);
    card.appendChild(info);
    el.appendChild(card);

    document.getElementById('gen-result').hidden = false;
    document.getElementById('gen-result').scrollIntoView({ behavior: 'smooth', block: 'nearest' });

    history.unshift(r);
    if (history.length > 5) history.pop();
    renderHistory();
  }

  function renderHistory() {
    var box = document.getElementById('gen-history');
    var list = document.getElementById('history-list');
    list.innerHTML = '';
    history.forEach(function (r) {
      var li = document.createElement('li');
      li.innerHTML = '<span class="zh">' + r.zh + '</span> <em>' + r.pinyin + '</em> — ' + r.gloss + ' · ' + r.tails[2];
      list.appendChild(li);
    });
    box.hidden = history.length === 0;
  }

  function copyResult() {
    if (!history.length) return;
    var r = history[0];
    var g = r.guardian;
    var text = r.zh + ' ' + r.pinyin + ' — ' + r.gloss +
      ' · ' + r.tails[0] + ' ' + r.tails[2] + ' · ' + r.element +
      ' · Guardian beast: ' + g.en + ' (' + g.zh + ')' +
      ' https://chinesebestiary.com/creatures/' + g.slug + '/';
    var done = function () {
      var btn = document.getElementById('copy-btn');
      btn.textContent = 'Copied!';
      setTimeout(function () { btn.textContent = 'Copy result'; }, 1500);
    };
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(done, function () { fallbackCopy(text); done(); });
    } else {
      fallbackCopy(text); done();
    }
  }

  function fallbackCopy(text) {
    var ta = document.createElement('textarea');
    ta.value = text;
    document.body.appendChild(ta);
    ta.select();
    try { document.execCommand('copy'); } catch (e) {}
    document.body.removeChild(ta);
  }

  document.getElementById('gen-btn').addEventListener('click', function () {
    if (typeof gtag === 'function') gtag('event', 'generate_fox_name');
    render(generate());
  });
  document.getElementById('again-btn').addEventListener('click', function () {
    if (typeof gtag === 'function') gtag('event', 'generate_fox_name');
    render(generate());
  });
  document.getElementById('copy-btn').addEventListener('click', copyResult);
})();
</script>

<style>
  .lede { font-size: 0.97rem; }
  .generator { background: #fff; border: 1px solid #e0d9c8; border-radius: 4px; padding: 1.5rem; margin: 1.5rem 0; }
  .controls { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; align-items: flex-end; }
  .controls label { display: flex; flex-direction: column; gap: 0.3rem; font-size: 0.85rem; color: var(--mist); }
  .controls select {
    font-family: Georgia, serif; font-size: 0.95rem; padding: 0.45rem 0.6rem;
    border: 1px solid #d8d0bc; border-radius: 3px; background: var(--paper); color: var(--ink);
    min-width: 12rem;
  }
  .forge-btn {
    font-family: 'Cinzel', Georgia, serif; font-size: 1rem; letter-spacing: 0.04em;
    background: var(--vermillion); color: #faf8f3; border: none; border-radius: 3px;
    padding: 0.6rem 1.6rem; cursor: pointer; transition: background 0.15s, transform 0.1s;
  }
  .forge-btn:hover { background: #a5301f; }
  .forge-btn:active { transform: scale(0.98); }
  .forge-btn .zh { font-family: "Noto Serif SC", serif; margin-left: 0.3rem; }

  .result { margin-top: 1.5rem; border-top: 1px solid #e0d9c8; padding-top: 1.5rem; }
  .result-main { display: flex; gap: 1.25rem; align-items: center; }
  .seal {
    flex-shrink: 0; width: 4rem; height: 4rem;
    background: var(--vermillion); color: #faf8f3; border-radius: 4px;
    display: flex; align-items: center; justify-content: center;
    font-family: "Noto Serif SC", serif; font-size: 2.2rem; font-weight: 600;
    box-shadow: 2px 2px 0 rgba(192,57,43,0.25);
  }
  .result-zh { font-size: 2.2rem; font-weight: 600; line-height: 1.2; }
  .result-pinyin { color: var(--vermillion); font-size: 0.95rem; letter-spacing: 0.03em; }
  .result-gloss { color: var(--mist); font-size: 0.9rem; font-style: italic; }
  .result-meta { display: flex; flex-wrap: wrap; gap: 0.75rem 2rem; margin: 1.25rem 0; padding: 0; }
  .result-meta dt { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--mist); }
  .result-meta dd { margin: 0.15rem 0 0; font-size: 0.95rem; }

  .guardian-card {
    display: flex; gap: 1rem; align-items: center; text-decoration: none;
    background: var(--paper); border: 1px solid #e0d9c8; border-radius: 4px;
    padding: 0.9rem 1.1rem; transition: border-color 0.15s, box-shadow 0.15s;
  }
  .guardian-card:hover { border-color: var(--gold); box-shadow: 2px 3px 10px rgba(26,26,46,0.08); }
  .guardian-card img { width: 72px; height: 72px; object-fit: cover; border-radius: 3px; border: 1px solid #e0d9c8; background: #fff; }
  .guardian-name { font-size: 0.95rem; color: var(--ink); }
  .guardian-sub { font-size: 0.82rem; color: var(--mist); }
  .guardian-link { font-size: 0.85rem; color: var(--vermillion); margin-top: 0.2rem; }

  .result-actions { display: flex; gap: 0.75rem; margin-top: 1.25rem; }
  .ghost-btn {
    font-family: Georgia, serif; font-size: 0.88rem; padding: 0.45rem 1.1rem;
    background: transparent; color: var(--ink); border: 1px solid #d8d0bc; border-radius: 3px;
    cursor: pointer; transition: border-color 0.15s, color 0.15s;
  }
  .ghost-btn:hover { border-color: var(--vermillion); color: var(--vermillion); }

  .history { margin-top: 1.5rem; }
  .history h3 { margin-top: 0; }
  .history ul { list-style: none; margin: 0; padding: 0; }
  .history li { font-size: 0.88rem; color: var(--mist); padding: 0.35rem 0; border-bottom: 1px dashed #e0d9c8; }
  .history li .zh { color: var(--ink); }
  .history li em { color: var(--vermillion); font-style: normal; }

  .creature-cta { background: var(--paper); border: 1px solid #e0d9c8; border-radius: 4px; padding: 0.9rem 1.1rem; font-size: 0.9rem; }
  .creature-cta a { color: var(--vermillion); }

  details { border: 1px solid #e0d9c8; border-radius: 4px; padding: 0.7rem 1rem; margin: 0.6rem 0; background: #fff; }
  summary { cursor: pointer; font-weight: bold; font-size: 0.95rem; }
  details p { font-size: 0.9rem; margin: 0.6rem 0 0.2rem; }

  @media (max-width: 46rem) {
    .controls { flex-direction: column; align-items: stretch; }
    .controls select { min-width: 0; }
    .result-zh { font-size: 1.7rem; }
  }
</style>
