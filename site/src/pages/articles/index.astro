---
import Base from '../../layouts/Base.astro';

const articles: { href: string; title: string; subtitle: string; description: string; date: string }[] = [];
---

<Base title="Articles — The Chinese Bestiary" description="Long-form guides from The Chinese Bestiary: Chinese mythology in the modern world, from spacecraft names to festival traditions, each traced to its source texts." image="/images/creatures/zhurong.jpg">
  <h1 class="page-h1">Articles <span class="zh">专题文章</span></h1>
  <p>Long-form guides that follow Chinese mythology out of the bestiary and into the modern world — every claim traced back to a source text.</p>

  <ul class="article-list">
    {articles.length === 0 && <p style="color: var(--mist); font-size: 0.9rem;">Articles coming soon.</p>}
    {articles.map(a => (
      <li class="article-card">
        <a class="article-title" href={a.href}>{a.title}</a>
        <span class="article-subtitle">{a.subtitle}</span>
        <p class="article-desc">{a.description}</p>
        <span class="article-date">{a.date}</span>
      </li>
    ))}
  </ul>
</Base>

<style>
  .page-h1 { font-family: 'Cinzel', Georgia, serif; font-size: 1.45rem; margin: 0 0 0.8rem; }
  .article-list { list-style: none; margin: 1.2rem 0; padding: 0; display: grid; gap: 1rem; }
  .article-card {
    border: 1px solid #e0d9c8; border-left: 4px solid var(--gold);
    border-radius: 0 4px 4px 0; background: #fff; padding: 1rem 1.2rem;
  }
  .article-title {
    font-family: 'Cinzel', Georgia, serif; font-weight: 700; font-size: 1.05rem;
    color: var(--ink); text-decoration: none;
  }
  .article-title:hover { color: var(--vermillion); }
  .article-subtitle { display: block; font-size: 0.85rem; color: var(--mist); font-style: italic; margin-top: 0.15rem; }
  .article-desc { font-size: 0.9rem; margin: 0.5rem 0 0.4rem; }
  .article-date { font-size: 0.78rem; color: var(--mist); }
</style>
