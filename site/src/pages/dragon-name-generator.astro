---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SubscribeBand from '../components/SubscribeBand.astro';
import { getCreatureImage } from '../utils/creatureImage';

const CATEGORY_LABELS: Record<string, string> = {
  divine_beast: 'Divine Beast',
  fierce_beast: 'Fierce Beast',
  auspicious_beast: 'Auspicious Beast',
  deity: 'Deity',
  strange_being: 'Strange Being',
  hybrid: 'Hybrid',
};

const beasts = (await getCollection('creatures')).map(c => ({
  slug: c.data.id,
  en: c.data.name.en,
  zh: c.data.name.zh_cn,
  pinyin: c.data.name.pinyin,
  element: c.data.taxonomy.element,
  category: c.data.taxonomy.category,
  categoryLabel: CATEGORY_LABELS[c.data.taxonomy.category] ?? c.data.taxonomy.category,
  image: getCreatureImage(c.data.id),
}));

const title = 'Chinese Dragon Name Generator — Long Wang & Azure Dragon Names';
const description = 'Generate an authentic Chinese dragon name (龙名): elemental color prefixes, cosmic concept suffixes, dragon titles — and a guardian beast from the Classic of Mountains and Seas, from Yinglong the winged dragon to the Dragon King himself.';
---

<Base title={title} description={description} image="/images/creatures/qinglong.jpg">
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What kinds of dragons appear in Chinese mythology?",
        "acceptedAnswer": { "@type": "Answer", "text": "Chinese mythology has many distinct dragon types: the jiao (蛟), a serpentine water dragon that can become a true dragon after 500 years; the qiu (虬), a hornless dragon; the long (龙), the standard true dragon with horns and claws; and the ying long (应龙), a winged dragon of great antiquity. The Dragon King (龙王) governs each ocean or major river from an underwater palace." }
      },
      {
        "@type": "Question",
        "name": "What does the color prefix in a dragon name mean?",
        "acceptedAnswer": { "@type": "Answer", "text": "Color prefixes in Chinese dragon names signal elemental alignment and personality. Azure (苍/青) = the Azure Dragon of the East, spring, wood. Crimson (赤) = fire. Black or dark (玄/黑) = water or the void. Gold (金) = metal and imperial authority. Purple (紫) = celestial nobility. The four directional dragons — Azure (East), White (West), Vermilion (South), Black (North) — follow this color system." }
      },
      {
        "@type": "Question",
        "name": "What is the Long Wang (龙王)?",
        "acceptedAnswer": { "@type": "Answer", "text": "The Dragon King (龙王) is the ruler of the underwater realm — in Chinese mythology there are four Dragon Kings, one for each sea: East (Ao Guang), South (Ao Qin), West (Ao Run), and North (Ao Shun). They control rainfall, river flooding, and ocean storms. A fifth Dragon King rules the central (land) realm. In the Classic of Mountains and Seas, dragon-type beings appear throughout as both divine creatures and guardians of specific mountains." }
      },
      {
        "@type": "Question",
        "name": "Can I use a generated name in my novel or game?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. Every component is built from public-domain classical vocabulary. Individual names are not copyrightable. Use them freely in fiction, wuxia settings, games, or as usernames." }
      }
    ]
  })} />

  <h1>Dragon Name Generator <span class="zh">龙名生成器</span></h1>

  <p class="lede">Generate an authentic <strong>Chinese dragon name</strong> in the classical style: an elemental color prefix, a cosmic concept suffix, and a title worthy of a Dragon King — with dragon rank, elemental affinity, and a guardian beast drawn from the 4th-century BCE <em>Shanhaijing</em>.</p>

  <div class="generator">
    <div class="controls">
      <label>
        Element <span class="zh">五行</span>
        <select id="dragon-element">
          <option value="any">Fate decides</option>
          <option value="water">Water 水</option>
          <option value="thunder">Thunder 雷</option>
          <option value="fire">Fire 火</option>
          <option value="wind">Wind 风</option>
          <option value="earth">Earth 土</option>
          <option value="metal">Metal 金</option>
          <option value="wood">Wood 木</option>
        </select>
      </label>
      <button id="gen-btn" class="forge-btn" type="button">Forge My Name <span class="zh">铸龙名</span></button>
    </div>

    <div class="result" id="gen-result" hidden>
      <div class="result-main">
        <div class="seal" aria-hidden="true">龙</div>
        <div class="result-name-block">
          <div class="result-zh zh" id="r-zh">—</div>
          <div class="result-pinyin" id="r-pinyin"></div>
          <div class="result-gloss" id="r-gloss"></div>
        </div>
      </div>
      <dl class="result-meta">
        <div><dt>Dragon Rank</dt><dd id="r-rank"></dd></div>
        <div><dt>Element</dt><dd id="r-element"></dd></div>
      </dl>
      <div class="guardian" id="r-guardian"></div>
      <div class="result-actions">
        <button id="copy-btn" class="ghost-btn" type="button">Copy result</button>
        <button id="again-btn" class="ghost-btn" type="button">Forge again</button>
      </div>
    </div>

    <div class="history" id="gen-history" hidden>
      <h3>Previous names <span class="zh">前世</span></h3>
      <ul id="history-list"></ul>
    </div>
  </div>

  <h3>How Chinese dragon names work <span class="zh">龙名之道</span></h3>
  <p>Chinese dragon names follow a consistent pattern: a <strong>color or element prefix</strong> establishes the dragon's nature and alignment, a <strong>concept suffix</strong> declares their domain (渊 for the abyss, 霄 for the heavens, 腾 for ascending flight), and a <strong>title</strong> gives rank. A dragon who rules the deep ocean might be called 玄渊龙王 — Black-Abyss Dragon King. A dragon of thunderstorms might be 赤霄天龙 — Crimson-Heaven Heavenly Dragon.</p>
  <p>In the <em>Shanhaijing</em>, dragons appear in several distinct forms. Yinglong (应龙), the winged dragon, helped Yu the Great control the Great Flood. Zhulong (烛龙), the Candle Dragon of the North, holds the sun in its mouth — each blink is a day, each sleep a night. The Dragon Kings of the four seas govern rainfall and ocean storms from underwater palaces. All draw from the same classical vocabulary this generator uses.</p>

  <p class="creature-cta">Explore the Dragon King in the original text: <a href="/creatures/long-wang/">Dragon King 龙王 →</a> · <a href="/creatures/qinglong/">Azure Dragon 青龙 →</a></p>

  <h3>FAQ</h3>
  <details>
    <summary>What is the difference between a jiao (蛟) and a long (龙)?</summary>
    <p>A jiao is a serpentine dragon-in-progress — it has not yet fully transformed. After 500 years, a jiao can ascend to become a hornless qiu (虬); after 1,000 years, a true horned long (龙). The transformation is tied to cultivating spiritual power, much like fox spirits gaining tails.</p>
  </details>
  <details>
    <summary>What do the color prefixes mean?</summary>
    <p>Azure/green (苍/青) = East, spring, wood; Crimson (赤) = South, fire; White (白) = West, metal; Black/dark (玄) = North, water. Gold (金) = imperial power. Purple (紫) = celestial nobility. These map directly to the five-phase (五行) cosmological system.</p>
  </details>
  <details>
    <summary>Can I use a generated name in fiction?</summary>
    <p>Yes. Every component is from public-domain classical vocabulary. Use freely in novels, games, or usernames — names are not copyrightable.</p>
  </details>

  <SubscribeBand />
</Base>

<script type="application/json" id="gen-data" set:html={JSON.stringify({ beasts })}></script>

<script is:inline>
(function () {
  var data = JSON.parse(document.getElementById('gen-data').textContent);
  var beasts = data.beasts;

  var DRAGON_PREFIXES = [
    ['苍', 'Cāng', 'Dark Azure'],
    ['碧', 'Bì', 'Jade Green'],
    ['赤', 'Chì', 'Crimson'],
    ['玄', 'Xuán', 'Mysterious Black'],
    ['金', 'Jīn', 'Golden'],
    ['白', 'Bái', 'White'],
    ['紫', 'Zǐ', 'Purple'],
    ['青', 'Qīng', 'Azure'],
    ['黑', 'Hēi', 'Obsidian'],
    ['翠', 'Cuì', 'Kingfisher Blue'],
  ];

  var DRAGON_SUFFIXES = [
    ['渊', 'yuān', 'Abyss'],
    ['霄', 'xiāo', 'Heavens'],
    ['鳞', 'lín', 'Scales'],
    ['腾', 'téng', 'Ascending'],
    ['息', 'xī', 'Breath'],
    ['云', 'yún', 'Clouds'],
    ['潮', 'cháo', 'Tides'],
    ['冥', 'míng', 'The Deep Dark'],
    ['雷', 'léi', 'Thunder'],
    ['鸿', 'hóng', 'Vast'],
  ];

  var DRAGON_TITLES = [
    ['龙王', 'Lóngwáng', 'Dragon King'],
    ['龙君', 'Lóngjūn', 'Dragon Lord'],
    ['海主', 'Hǎizhǔ', 'Sea Master'],
    ['渊尊', 'Yuānzūn', 'Abyss Venerable'],
    ['天龙', 'Tiānlóng', 'Heavenly Dragon'],
    ['龙祖', 'Lóngzǔ', 'Dragon Ancestor'],
    ['神龙', 'Shénlóng', 'Divine Dragon'],
    ['蛟尊', 'Jiāozūn', 'Flood Dragon Venerable'],
  ];

  var DRAGON_EPITHETS = [
    ['应龙', 'Yìnglóng', 'Winged Dragon', 'yinglong'],
    ['青龙', 'Qīnglóng', 'Azure Dragon', 'qinglong'],
    ['烛龙', 'Zhúlóng', 'Candle Dragon', 'zhulong'],
    ['翔龙', 'Xiánglóng', 'Soaring Dragon', null],
    ['盘龙', 'Pánlóng', 'Coiling Dragon', null],
    ['潜渊', 'Qiányuān', 'Submerged Abyss', null],
    ['穿云', 'Chuānyún', 'Cloud-Piercing', null],
    ['啸天', 'Xiàotiān', 'Heaven-Roaring', null],
  ];

  var DRAGON_RANKS = [
    ['幼龙', 'Newly Awakened Dragon'],
    ['蛟龙', 'Flood Dragon — 100 years'],
    ['虬龙', 'Hornless Dragon — 500 years'],
    ['真龙', 'True Dragon — 1,000 years'],
    ['神龙', 'Divine Dragon — 5,000 years'],
    ['古龙', 'Ancient Dragon — 10,000 years'],
    ['天龙', 'Heavenly Dragon — Beyond Reckoning'],
  ];

  var ELEMENTS = { fire: 'Fire 火', water: 'Water 水', wood: 'Wood 木', metal: 'Metal 金', earth: 'Earth 土', wind: 'Wind 风', thunder: 'Thunder 雷' };

  var DRAGON_SLUGS = ['yinglong', 'qinglong', 'long-wang', 'zhulong'];

  function pick(arr) { return arr[Math.floor(Math.random() * arr.length)]; }

  function generate() {
    var elementId = document.getElementById('dragon-element').value;

    var nameZh, namePy, gloss;
    var beastSlug = null;

    if (Math.random() < 0.25) {
      var ep = pick(DRAGON_EPITHETS);
      var ti = pick(DRAGON_TITLES);
      nameZh = ep[0] + ti[0];
      namePy = ep[1] + ' ' + ti[1];
      gloss = ep[2] + ' ' + ti[2];
      beastSlug = ep[3];
    } else {
      var pre = pick(DRAGON_PREFIXES);
      var suf = pick(DRAGON_SUFFIXES);
      var ti = pick(DRAGON_TITLES);
      nameZh = pre[0] + suf[0] + ti[0];
      namePy = pre[1] + suf[1] + ' ' + ti[1];
      gloss = pre[2] + '-' + suf[2] + ' ' + ti[2];
    }

    var rank = pick(DRAGON_RANKS);

    var element = elementId;
    if (element === 'any') {
      var pool = beasts.filter(function (b) { return b.element !== 'none'; });
      element = pool.length ? pick(pool).element : 'water';
    }

    var dragonBeasts = DRAGON_SLUGS.map(function (s) {
      return beasts.find(function (b) { return b.slug === s; });
    }).filter(Boolean);

    var guardians = beasts.filter(function (b) { return b.element === element; });

    var guardian;
    if (beastSlug) {
      guardian = beasts.find(function (b) { return b.slug === beastSlug; })
        || (dragonBeasts.length ? pick(dragonBeasts) : pick(beasts));
    } else if (dragonBeasts.length && Math.random() < 0.7) {
      guardian = pick(dragonBeasts);
    } else {
      guardian = guardians.length ? pick(guardians) : pick(beasts);
    }

    return {
      zh: nameZh, pinyin: namePy, gloss: gloss,
      rank: rank, element: ELEMENTS[element] || element,
      guardian: guardian
    };
  }

  var history = [];

  function render(r) {
    document.getElementById('r-zh').textContent = r.zh;
    document.getElementById('r-pinyin').textContent = r.pinyin;
    document.getElementById('r-gloss').textContent = r.gloss;
    document.getElementById('r-rank').textContent = r.rank[0] + ' — ' + r.rank[1];
    document.getElementById('r-element').textContent = r.element;

    var g = r.guardian;
    var el = document.getElementById('r-guardian');
    el.innerHTML = '';
    var card = document.createElement('a');
    card.href = '/creatures/' + g.slug + '/';
    card.className = 'guardian-card';
    if (g.image) {
      var img = document.createElement('img');
      img.src = g.image;
      img.alt = g.en;
      img.width = 72; img.height = 72;
      card.appendChild(img);
    }
    var info = document.createElement('div');
    info.className = 'guardian-info';
    var t1 = document.createElement('div');
    t1.className = 'guardian-name';
    t1.innerHTML = 'Guardian beast: <strong>' + g.en + ' <span class="zh">' + g.zh + '</span></strong>';
    var t2 = document.createElement('div');
    t2.className = 'guardian-sub';
    t2.textContent = g.categoryLabel + ' · ' + g.pinyin;
    var t3 = document.createElement('div');
    t3.className = 'guardian-link';
    t3.textContent = 'Read its original Shanhaijing entry →';
    info.appendChild(t1); info.appendChild(t2); info.appendChild(t3);
    card.appendChild(info);
    el.appendChild(card);

    document.getElementById('gen-result').hidden = false;
    document.getElementById('gen-result').scrollIntoView({ behavior: 'smooth', block: 'nearest' });

    history.unshift(r);
    if (history.length > 5) history.pop();
    renderHistory();
  }

  function renderHistory() {
    var box = document.getElementById('gen-history');
    var list = document.getElementById('history-list');
    list.innerHTML = '';
    history.forEach(function (r) {
      var li = document.createElement('li');
      li.innerHTML = '<span class="zh">' + r.zh + '</span> <em>' + r.pinyin + '</em> — ' + r.gloss + ' · ' + r.rank[1].split(' — ')[0];
      list.appendChild(li);
    });
    box.hidden = history.length === 0;
  }

  function copyResult() {
    if (!history.length) return;
    var r = history[0];
    var g = r.guardian;
    var text = r.zh + ' ' + r.pinyin + ' — ' + r.gloss +
      ' · ' + r.rank[0] + ' ' + r.rank[1] + ' · ' + r.element +
      ' · Guardian beast: ' + g.en + ' (' + g.zh + ')' +
      ' https://chinesebestiary.com/creatures/' + g.slug + '/';
    var done = function () {
      var btn = document.getElementById('copy-btn');
      btn.textContent = 'Copied!';
      setTimeout(function () { btn.textContent = 'Copy result'; }, 1500);
    };
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(done, function () { fallbackCopy(text); done(); });
    } else {
      fallbackCopy(text); done();
    }
  }

  function fallbackCopy(text) {
    var ta = document.createElement('textarea');
    ta.value = text;
    document.body.appendChild(ta);
    ta.select();
    try { document.execCommand('copy'); } catch (e) {}
    document.body.removeChild(ta);
  }

  document.getElementById('gen-btn').addEventListener('click', function () {
    if (typeof gtag === 'function') gtag('event', 'generate_dragon_name');
    render(generate());
  });
  document.getElementById('again-btn').addEventListener('click', function () {
    if (typeof gtag === 'function') gtag('event', 'generate_dragon_name');
    render(generate());
  });
  document.getElementById('copy-btn').addEventListener('click', copyResult);
})();
</script>

<style>
  .lede { font-size: 0.97rem; }
  .generator { background: #fff; border: 1px solid #e0d9c8; border-radius: 4px; padding: 1.5rem; margin: 1.5rem 0; }
  .controls { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; align-items: flex-end; }
  .controls label { display: flex; flex-direction: column; gap: 0.3rem; font-size: 0.85rem; color: var(--mist); }
  .controls select {
    font-family: Georgia, serif; font-size: 0.95rem; padding: 0.45rem 0.6rem;
    border: 1px solid #d8d0bc; border-radius: 3px; background: var(--paper); color: var(--ink);
    min-width: 12rem;
  }
  .forge-btn {
    font-family: 'Cinzel', Georgia, serif; font-size: 1rem; letter-spacing: 0.04em;
    background: var(--vermillion); color: #faf8f3; border: none; border-radius: 3px;
    padding: 0.6rem 1.6rem; cursor: pointer; transition: background 0.15s, transform 0.1s;
  }
  .forge-btn:hover { background: #a5301f; }
  .forge-btn:active { transform: scale(0.98); }
  .forge-btn .zh { font-family: "Noto Serif SC", serif; margin-left: 0.3rem; }

  .result { margin-top: 1.5rem; border-top: 1px solid #e0d9c8; padding-top: 1.5rem; }
  .result-main { display: flex; gap: 1.25rem; align-items: center; }
  .seal {
    flex-shrink: 0; width: 4rem; height: 4rem;
    background: var(--vermillion); color: #faf8f3; border-radius: 4px;
    display: flex; align-items: center; justify-content: center;
    font-family: "Noto Serif SC", serif; font-size: 2.2rem; font-weight: 600;
    box-shadow: 2px 2px 0 rgba(192,57,43,0.25);
  }
  .result-zh { font-size: 2.2rem; font-weight: 600; line-height: 1.2; }
  .result-pinyin { color: var(--vermillion); font-size: 0.95rem; letter-spacing: 0.03em; }
  .result-gloss { color: var(--mist); font-size: 0.9rem; font-style: italic; }
  .result-meta { display: flex; flex-wrap: wrap; gap: 0.75rem 2rem; margin: 1.25rem 0; padding: 0; }
  .result-meta dt { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--mist); }
  .result-meta dd { margin: 0.15rem 0 0; font-size: 0.95rem; }

  .guardian-card {
    display: flex; gap: 1rem; align-items: center; text-decoration: none;
    background: var(--paper); border: 1px solid #e0d9c8; border-radius: 4px;
    padding: 0.9rem 1.1rem; transition: border-color 0.15s, box-shadow 0.15s;
  }
  .guardian-card:hover { border-color: var(--gold); box-shadow: 2px 3px 10px rgba(26,26,46,0.08); }
  .guardian-card img { width: 72px; height: 72px; object-fit: cover; border-radius: 3px; border: 1px solid #e0d9c8; background: #fff; }
  .guardian-name { font-size: 0.95rem; color: var(--ink); }
  .guardian-sub { font-size: 0.82rem; color: var(--mist); }
  .guardian-link { font-size: 0.85rem; color: var(--vermillion); margin-top: 0.2rem; }

  .result-actions { display: flex; gap: 0.75rem; margin-top: 1.25rem; }
  .ghost-btn {
    font-family: Georgia, serif; font-size: 0.88rem; padding: 0.45rem 1.1rem;
    background: transparent; color: var(--ink); border: 1px solid #d8d0bc; border-radius: 3px;
    cursor: pointer; transition: border-color 0.15s, color 0.15s;
  }
  .ghost-btn:hover { border-color: var(--vermillion); color: var(--vermillion); }

  .history { margin-top: 1.5rem; }
  .history h3 { margin-top: 0; }
  .history ul { list-style: none; margin: 0; padding: 0; }
  .history li { font-size: 0.88rem; color: var(--mist); padding: 0.35rem 0; border-bottom: 1px dashed #e0d9c8; }
  .history li .zh { color: var(--ink); }
  .history li em { color: var(--vermillion); font-style: normal; }

  .creature-cta { background: var(--paper); border: 1px solid #e0d9c8; border-radius: 4px; padding: 0.9rem 1.1rem; font-size: 0.9rem; }
  .creature-cta a { color: var(--vermillion); }

  details { border: 1px solid #e0d9c8; border-radius: 4px; padding: 0.7rem 1rem; margin: 0.6rem 0; background: #fff; }
  summary { cursor: pointer; font-weight: bold; font-size: 0.95rem; }
  details p { font-size: 0.9rem; margin: 0.6rem 0 0.2rem; }

  @media (max-width: 46rem) {
    .controls { flex-direction: column; align-items: stretch; }
    .controls select { min-width: 0; }
    .result-zh { font-size: 1.7rem; }
  }
</style>
