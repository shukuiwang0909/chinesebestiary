---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const entries = (await getCollection('stories'))
  .sort((a, b) => a.data.id.localeCompare(b.data.id));

const creatures = await getCollection('creatures');
const nameOf = (id: string) => creatures.find(c => c.data.id === id)?.data.name.en ?? id;
---

<Base title="Stories — The Chinese Bestiary" description="Chinese folk tales retold in English, with the original texts: fox spirits, dynasty-killers, and the stories behind the beasts of the Shanhaijing.">
  <h2>Stories <span class="zh">民间故事</span></h2>
  <p>The bestiary tells you what each creature is; these pages tell you what it did. Folk tales and legend cycles from the <em>Soushen ji</em>, <em>Fengshen yanyi</em>, <em>Liaozhai</em> and beyond — retold in English with the key original passages quoted, everything sourced from public-domain texts.</p>

  <div class="story-grid">
    {entries.map(e => (
      <a class="story-card" href={`/stories/${e.data.id}/`}>
        <div class="story-meta">
          <span class="story-source">{e.data.source_work}</span>
          <span class="story-era">{e.data.era}</span>
        </div>
        <h3>{e.data.title}</h3>
        <p class="story-summary">{e.data.summary.slice(0, 150)}{e.data.summary.length > 150 ? '…' : ''}</p>
        {e.data.related_creatures.length > 0 && (
          <p class="story-creatures">
            {e.data.related_creatures.map((id, i) => (
              <span>{i > 0 && ' · '}{nameOf(id)}</span>
            ))}
          </p>
        )}
      </a>
    ))}
  </div>
</Base>

<style>
  .story-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(22rem, 1fr));
    gap: 1.25rem;
    margin: 1.5rem 0;
  }
  .story-card {
    display: flex; flex-direction: column; gap: 0.5rem;
    border: 1px solid #e0d9c8; background: #fff; padding: 1.2rem 1.4rem;
    text-decoration: none; color: var(--ink); border-radius: 4px;
    transition: translate 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
    border-top: 3px solid var(--gold);
  }
  .story-card:hover {
    translate: 0 -3px;
    box-shadow: 0 6px 18px rgba(26,26,46,0.1);
    border-top-color: var(--vermillion);
    border-color: var(--gold);
  }
  .story-meta { display: flex; align-items: center; gap: 0.6rem; }
  .story-source {
    font-size: 0.75rem; font-weight: 600; letter-spacing: 0.04em;
    color: var(--vermillion); text-transform: uppercase;
  }
  .story-era {
    font-size: 0.75rem; color: var(--mist);
  }
  .story-card h3 {
    font-size: 1rem; margin: 0; border: none; padding: 0; color: var(--ink);
    line-height: 1.35;
  }
  .story-summary { font-size: 0.88rem; color: #555; line-height: 1.6; margin: 0; }
  .story-creatures {
    font-size: 0.78rem; color: var(--mist); margin: 0;
    border-top: 1px solid #f0ece0; padding-top: 0.5rem;
  }
</style>
