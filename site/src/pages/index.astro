---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CreatureCard from '../components/CreatureCard.astro';

const creatures = await getCollection('creatures');
const sorted = creatures.sort((a, b) => a.data.id.localeCompare(b.data.id));
---
<Base title="The Chinese Bestiary — Every Creature from the Shanhaijing" description="A searchable bestiary of every mythical creature in the Classic of Mountains and Seas (山海经): original texts, new translations, and D&D 5E stat blocks.">
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "The Chinese Bestiary",
    "alternateName": "中国图鉴 · 山海经异兽",
    "url": "https://chinesebestiary.com/",
    "description": "A searchable bestiary of every mythical creature in the Classic of Mountains and Seas (山海经): original texts, new translations, and D&D 5E stat blocks.",
    "inLanguage": "en",
    "publisher": {
      "@type": "Organization",
      "name": "The Chinese Bestiary",
      "url": "https://chinesebestiary.com/",
      "logo": "https://chinesebestiary.com/favicon.png"
    }
  })} />
  <h2>Every creature from the <em>Classic of Mountains and Seas</em></h2>
  <p>The <em>Shanhaijing</em> (山海经, c. 4th century BCE) describes over 200 mythical beings — beasts that forecast empires, mountains that walk, and rivers that burn. This bestiary catalogs them with original-source texts, new English translations, and tabletop-ready stat blocks.</p>

  <h3>Creatures <span class="zh">神兽</span> ({sorted.length})</h3>
  <div class="grid">
    {sorted.map(c => <CreatureCard creature={c} />)}
  </div>

  <p><em>More entries added weekly.</em></p>

  <h3>Groups <span class="zh">合集</span></h3>
  <ul>
    <li><a href="/four-perils/"><strong>The Four Perils</strong></a> <span class="zh">四凶</span> — Taotie, Hundun, Qiongqi, Taowu: China's villainous quartet, from exiled clans to man-eating beasts</li>
    <li><a href="/four-divine/"><strong>The Four Divine</strong></a> <span class="zh">四灵</span> — Qilin, Fenghuang, Tortoise, Dragon: the benevolent quartet of the Book of Rites</li>
  </ul>

  <h3>Real-World Theories <span class="zh">现实原型</span></h3>
  <p>Was the nine-tailed fox based on a real animal? Each page takes the internet's wildest origin theory seriously enough to check it — claim, evidence, what scholars say, and a verdict. <a href="/real-world/">Explore the theories</a>.</p>

  <h3>Stories <span class="zh">民间故事</span></h3>
  <p>The bestiary tells you what each creature is; the stories tell you what it did — fox spirits, dynasty-killers, and the legend cycles behind the beasts, retold in English from public-domain sources. <a href="/stories/">Read the stories</a>.</p>

  <!-- P2: Name Generator -->
</Base>

<style>
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1rem; margin: 1rem 0; }
</style>
