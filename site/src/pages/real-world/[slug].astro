---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ReadingList from '../../components/ReadingList.astro';
import { getCreatureImage } from '../../utils/creatureImage';

export async function getStaticPaths() {
  const entries = await getCollection('realworld');
  return entries.map(entry => ({
    params: { slug: entry.data.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const creature = (await getCollection('creatures')).find(c => c.data.id === d.id);

const VERDICT_LABEL: Record<string, string> = {
  likely: 'Likely',
  unlikely: 'Unlikely',
  dubious: 'Dubious',
  unverified: 'Unverified',
};
const VERDICT_COLOR: Record<string, string> = {
  likely: 'var(--cat-auspicious)',
  unlikely: 'var(--cat-hybrid)',
  dubious: 'var(--cat-fierce)',
  unverified: 'var(--mist)',
};
---
<Base title={d.seo.meta_title} description={d.seo.meta_description} image={getCreatureImage(d.id) ?? undefined} ogType="article">
  <div class="read-progress" id="read-progress" role="progressbar" aria-hidden="true"></div>
  <article>
    <nav class="rw-breadcrumb">
      <a class="back-link" href="/real-world/">All Theories</a>
      {creature && (
        <span class="rw-bc-sep" aria-hidden="true">·</span>
        <a href={`/creatures/${d.id}/`} class="rw-creature-link">
          The myth: <strong>{creature.data.name.en}</strong>
          <span class="zh">{creature.data.name.zh_cn}</span>
        </a>
      )}
    </nav>

    <h1>{d.seo.meta_title}</h1>

    <section class="rw-section rw-claim">
      <h3>The Claim</h3>
      <p>{d.claim}</p>
    </section>

    <section class="rw-section rw-evidence">
      <h3>The Evidence</h3>
      <p>{d.evidence}</p>
    </section>

    <section class="rw-section rw-scholars">
      <h3>What Scholars Say</h3>
      <p>{d.scholars_say}</p>
    </section>

    <section class="rw-section rw-verdict">
      <h3>The Verdict</h3>
      <div class="verdict-card" style={`--vc: ${VERDICT_COLOR[d.verdict]}`}>
        <span class="verdict-badge">{VERDICT_LABEL[d.verdict]}</span>
        <div class="verdict-content"><Content /></div>
      </div>
    </section>

    {d.candidates.length > 0 && (
      <section class="rw-section">
        <h3>The Candidates</h3>
        <div class="candidates">
          {d.candidates.map(c => (
            <figure>
              <img src={c.image} alt={c.name} loading="lazy" />
              <figcaption>
                <strong>{c.name}</strong><br />
                <small><a href={c.source_url} rel="noopener noreferrer">{c.license}</a></small>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}
  </article>

  <ReadingList />

  <script is:inline>
    (function() {
      var bar = document.getElementById('read-progress');
      if (!bar) return;
      window.addEventListener('scroll', function() {
        var h = document.documentElement;
        var pct = (h.scrollTop || document.body.scrollTop) / (h.scrollHeight - h.clientHeight);
        bar.style.width = Math.min(Math.round(pct * 1000) / 10, 100) + '%';
      }, { passive: true });
    })();
  </script>
</Base>

<style>
  .read-progress {
    position: fixed; top: 0; left: 0; height: 3px; width: 0;
    background: linear-gradient(90deg, var(--gold), var(--vermillion));
    z-index: 200; pointer-events: none; transition: width 0.1s linear;
  }
  @media (prefers-reduced-motion: reduce) { .read-progress { display: none; } }

  .rw-breadcrumb { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; margin-bottom: 1.2rem; }
  .rw-bc-sep { color: #ccc; }
  .rw-creature-link { font-size: 0.85rem; color: var(--mist); text-decoration: none; }
  .rw-creature-link:hover { color: var(--vermillion); }
  .rw-creature-link .zh { font-size: 0.8rem; }

  .rw-section {
    border: 1px solid #e0d9c8; border-radius: 4px;
    padding: 0.8rem 1.2rem; margin: 1.2rem 0;
    background: #fff;
  }
  .rw-section h3 { margin-top: 0; }
  .rw-section p { margin-bottom: 0; }

  .rw-claim  { border-left: 4px solid var(--cat-strange); }
  .rw-evidence { border-left: 4px solid var(--gold); }
  .rw-scholars { border-left: 4px solid var(--cat-auspicious); }
  .rw-verdict { border: none; background: transparent; padding: 0; }

  .verdict-card {
    border: 2px solid var(--vc, var(--gold));
    border-radius: 6px; overflow: hidden;
  }
  .verdict-badge {
    display: block;
    background: var(--vc, var(--gold));
    color: #fff;
    font-family: 'Cinzel', Georgia, serif;
    font-size: 1rem; font-weight: 700;
    letter-spacing: 0.12em; text-transform: uppercase;
    padding: 0.6rem 1.2rem;
  }
  .verdict-content { padding: 0.8rem 1.2rem; background: #fff; }
  .verdict-content p { margin: 0; }

  .candidates { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 1rem; margin-top: 0.6rem; }
  .candidates figure { margin: 0; border: 1px solid #e0d9c8; padding: 0.5rem; background: #fff; border-radius: 3px; }
  .candidates img { width: 100%; aspect-ratio: 4/3; object-fit: cover; display: block; }
  .candidates figcaption { font-size: 0.8rem; color: #666; margin-top: 0.4rem; }
</style>
