---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const entries = (await getCollection('realworld'))
  .sort((a, b) => a.data.id.localeCompare(b.data.id));

const VERDICT_LABEL: Record<string, string> = {
  likely: 'Likely',
  unlikely: 'Unlikely',
  dubious: 'Dubious',
  unverified: 'Unverified',
};
const VERDICT_COLOR: Record<string, string> = {
  likely: 'var(--cat-auspicious)',
  unlikely: 'var(--cat-hybrid)',
  dubious: 'var(--cat-fierce)',
  unverified: 'var(--mist)',
};
---

<Base title="Real-World Theories — The Chinese Bestiary" description="Was the nine-tailed fox a real animal? Every page takes the internet's wildest Shanhaijing origin theory seriously enough to check it: the claim, the evidence, what scholars say, and a verdict." image="/images/creatures/nine-tailed-fox.jpg">
  <h2>Real-World Theories <span class="zh">现实原型</span></h2>
  <p>The internet claims every mythical beast was real — that the nine-tailed fox was a red panda, that dragons were dinosaurs, that the Shanhaijing is a misread field guide to a lost world. Each page takes one such claim seriously enough to check it: the claim, the evidence its supporters cite, what scholars actually say, and a verdict.</p>

  <div class="rw-grid">
    {entries.map(e => (
      <a class="rw-card" href={`/real-world/${e.data.id}/`}>
        <span
          class="verdict-badge"
          style={`--badge-color: ${VERDICT_COLOR[e.data.verdict]}`}
        >{VERDICT_LABEL[e.data.verdict]}</span>
        <h3>{e.data.seo.meta_title}</h3>
        <p class="rw-claim">{e.data.claim.slice(0, 140)}{e.data.claim.length > 140 ? '…' : ''}</p>
        <span class="rw-cta">Read the verdict →</span>
      </a>
    ))}
  </div>
</Base>

<style>
  .rw-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(22rem, 1fr));
    gap: 1.25rem;
    margin: 1.5rem 0;
  }
  .rw-card {
    display: flex; flex-direction: column; gap: 0.55rem;
    border: 1px solid #e0d9c8; background: #fff; padding: 1.2rem 1.4rem;
    text-decoration: none; color: var(--ink); border-radius: 4px;
    transition: translate 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }
  .rw-card:hover {
    translate: 0 -3px;
    box-shadow: 0 6px 18px rgba(26,26,46,0.1);
    border-color: var(--gold);
  }
  .verdict-badge {
    display: inline-block; align-self: flex-start;
    padding: 0.2rem 0.7rem; border-radius: 2rem;
    font-size: 0.72rem; font-weight: 700; letter-spacing: 0.06em;
    text-transform: uppercase; color: #fff;
    background: var(--badge-color, var(--mist));
  }
  .rw-card h3 { font-size: 1rem; margin: 0; border: none; padding: 0; line-height: 1.35; }
  .rw-claim { font-size: 0.87rem; color: #555; line-height: 1.6; margin: 0; flex: 1; }
  .rw-cta { font-size: 0.8rem; color: var(--vermillion); margin-top: auto; }
</style>
