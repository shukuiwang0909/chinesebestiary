---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getCreatureImage } from '../../utils/creatureImage';
import { CATEGORY_LABELS } from '../../utils/taxonomy';
import ReadingList from '../../components/ReadingList.astro';

export async function getStaticPaths() {
  const creatures = await getCollection('creatures');
  return creatures.map(entry => ({
    params: { slug: entry.data.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const imageSrc = getCreatureImage(d.id);
const rwIds = new Set((await getCollection('realworld')).map(e => e.data.id));
const storyLinks = (await getCollection('stories')).filter(s => s.data.related_creatures.includes(d.id));
const allCreatures = await getCollection('creatures');

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": d.seo.meta_title,
  "description": d.seo.meta_description,
  "about": {
    "@type": "Thing",
    "name": d.name.en,
    "alternateName": [d.name.zh_cn, d.name.pinyin, ...d.name.alt_names],
  },
  "inLanguage": "en",
  ...(imageSrc && { "image": `https://chinesebestiary.com${imageSrc}` }),
};
---
<Base title={d.seo.meta_title} description={d.seo.meta_description} image={imageSrc ?? undefined}>
  <div class="read-progress" id="read-progress" role="progressbar" aria-hidden="true"></div>
  <article>
    <h2>{d.name.en} <span class="zh">{d.name.zh_cn}</span></h2>
    <p class="creature-meta"><em>{d.name.pinyin} · Wade-Giles: {d.name.wade_giles}</em></p>
    <p class="creature-tags">
      <span class="tag" data-category={d.taxonomy.category}>{CATEGORY_LABELS[d.taxonomy.category]}</span>
      {d.taxonomy.four_perils && <> · <a href="/four-perils/">Four Perils 四凶</a></>}
      {d.taxonomy.four_divine && <> · <a href="/four-divine/">Four Divine 四灵</a></>}
    </p>

    {imageSrc && (
      <figure>
        <img src={imageSrc} alt={`${d.name.en} (${d.name.zh_cn}) — historical illustration`} loading="lazy" />
        {d.media?.historical_illustration && <figcaption><small>{d.media.historical_illustration}</small></figcaption>}
      </figure>
    )}

    <h3>Source Text <span class="zh">原文出处</span></h3>
    <p><strong>{d.source.chapter_zh}</strong> · {d.source.chapter_en}</p>
    {d.source.passages.map(p => (
      <blockquote>
        <p class="zh">{p.text_zh}</p>
        <p><em>{p.text_en}</em></p>
        {p.note && <p><small>{p.note}</small></p>}
      </blockquote>
    ))}
    {d.source.modern_location && <p><small>Modern location: {d.source.modern_location}</small></p>}

    <h3>Summary <span class="zh">概述</span></h3>
    <p>{d.content_summary}</p>

    {d.appearance && (<><h3>Appearance <span class="zh">外貌</span></h3><p>{d.appearance}</p></>)}

    {d.abilities.length > 0 && (
      <>
        <h3>Abilities <span class="zh">能力</span></h3>
        <ul>{d.abilities.map(a => <li>{a}</li>)}</ul>
      </>
    )}

    {d.symbolism && (<><h3>Symbolism <span class="zh">象征</span></h3><p>{d.symbolism}</p></>)}

    <h3>Cultural References <span class="zh">文化影响</span></h3>
    <table>
      <thead><tr><th>Work</th><th>Year</th><th>Note</th></tr></thead>
      <tbody>
        {d.cultural_references.map(r => (
          <tr><td>{r.work}</td><td>{r.year}</td><td>{r.note ?? ''}</td></tr>
        ))}
      </tbody>
    </table>

    <Content />

    {d.dnd5e?.stat_block && (
      <div class="stat-block" data-stat-text={d.dnd5e.stat_block}>
        <div class="stat-block-header">
          <span>D&amp;D 5E Stat Block</span>
          <span class="zh stat-block-zh">{d.name.zh_cn}</span>
          <button class="copy-btn" aria-label="Copy stat block to clipboard">Copy</button>
        </div>
        <pre class="stat-block-body">{d.dnd5e.stat_block}</pre>
      </div>
    )}

    <ReadingList />

    {d.seo.related_entries.length > 0 && (
      <>
        <h3>Related Creatures <span class="zh">相关</span></h3>
        <ul>
          {d.seo.related_entries.map(id => {
            const rc = allCreatures.find(cc => cc.data.id === id);
            return (
              <li>
                <a href={`/creatures/${id}/`}>
                  {rc ? rc.data.name.en : id.replace(/-/g, ' ')}
                  {rc && <span class="zh"> {rc.data.name.zh_cn}</span>}
                </a>
              </li>
            );
          })}
        </ul>
      </>
    )}
    {rwIds.has(d.id) && (
      <>
        <h3>Real-World Theories <span class="zh">现实原型</span></h3>
        <p>Was the {d.name.en} based on a real animal? <a href={`/real-world/${d.id}/`}>Examine the claim, the evidence, and the verdict →</a></p>
      </>
    )}
    {storyLinks.length > 0 && (
      <>
        <h3>Appears in Stories <span class="zh">相关故事</span></h3>
        <ul>
          {storyLinks.map(s => (
            <li><a href={`/stories/${s.data.id}/`}>{s.data.title}</a></li>
          ))}
        </ul>
      </>
    )}
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <script is:inline>
    (function() {
      var bar = document.getElementById('read-progress');
      if (bar) {
        window.addEventListener('scroll', function() {
          var h = document.documentElement;
          var pct = (h.scrollTop || document.body.scrollTop) / (h.scrollHeight - h.clientHeight);
          bar.style.width = Math.min(Math.round(pct * 1000) / 10, 100) + '%';
        }, { passive: true });
      }

      document.querySelectorAll('.copy-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var text = btn.closest('.stat-block').dataset.statText;
          if (!text) return;
          navigator.clipboard.writeText(text).then(function() {
            btn.textContent = '✓ Copied';
            btn.classList.add('copied');
            setTimeout(function() {
              btn.textContent = 'Copy';
              btn.classList.remove('copied');
            }, 2000);
          }).catch(function() {
            btn.textContent = 'Error';
            setTimeout(function() { btn.textContent = 'Copy'; }, 2000);
          });
        });
      });
    })();
  </script>
</Base>

<style>
  .read-progress {
    position: fixed; top: 0; left: 0; height: 3px; width: 0;
    background: linear-gradient(90deg, var(--gold), var(--vermillion));
    z-index: 200; pointer-events: none;
    transition: width 0.1s linear;
  }
  @media (prefers-reduced-motion: reduce) { .read-progress { display: none; } }
  .creature-meta { color: var(--mist); font-size: 0.9rem; margin: 0.2rem 0 0.6rem; }
  .creature-tags { margin: 0 0 1.2rem; }
  .tag {
    display: inline-block;
    font-size: 0.78rem; font-weight: 600; letter-spacing: 0.03em;
    padding: 0.2rem 0.65rem;
    border-radius: 2px;
    color: #fff;
    background: var(--cat-color, var(--gold));
  }
  .tag[data-category="divine_beast"]     { --cat-color: var(--cat-divine); }
  .tag[data-category="fierce_beast"]     { --cat-color: var(--cat-fierce); }
  .tag[data-category="auspicious_beast"] { --cat-color: var(--cat-auspicious); }
  .tag[data-category="deity"]            { --cat-color: var(--cat-deity); }
  .tag[data-category="strange_being"]    { --cat-color: var(--cat-strange); }
  .tag[data-category="hybrid"]           { --cat-color: var(--cat-hybrid); }

  figure { margin: 1.5rem 0; text-align: center; }
  figure img { max-width: min(100%, 360px); border: 1px solid #e0d9c8; padding: 0.5rem; background: #fff; border-radius: 3px; }
  figcaption { font-size: 0.8rem; color: var(--mist); margin-top: 0.5rem; }

  table { width: 100%; border-collapse: collapse; font-size: 0.88rem; margin: 0.8rem 0; }
  th { text-align: left; padding: 0.4rem 0.6rem; background: #f5f1e8; border-bottom: 2px solid var(--gold); font-family: 'Cinzel', Georgia, serif; font-size: 0.82rem; }
  td { padding: 0.4rem 0.6rem; border-bottom: 1px solid #e0d9c8; vertical-align: top; }
  tr:last-child td { border-bottom: none; }

  /* D&D Stat Block */
  .stat-block {
    border: 1px solid #c9a96e;
    border-radius: 4px;
    margin: 2rem 0;
    overflow: hidden;
    box-shadow: 2px 2px 8px rgba(26,26,46,0.08);
  }
  .stat-block-header {
    background: linear-gradient(90deg, var(--vermillion), #a93226);
    color: #faf8f3;
    padding: 0.65rem 1rem;
    font-family: 'Cinzel', Georgia, serif;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    display: flex; align-items: center; justify-content: space-between;
    gap: 0.5rem;
  }
  .copy-btn {
    margin-left: auto;
    padding: 0.2rem 0.7rem;
    font-size: 0.75rem; font-family: Georgia, serif; font-weight: 400;
    letter-spacing: 0.04em;
    background: rgba(255,255,255,0.15);
    color: #faf8f3;
    border: 1px solid rgba(255,255,255,0.35);
    border-radius: 3px;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
    white-space: nowrap;
  }
  .copy-btn:hover { background: rgba(255,255,255,0.28); border-color: rgba(255,255,255,0.6); }
  .copy-btn.copied { background: rgba(255,255,255,0.35); border-color: rgba(255,255,255,0.8); }
  .stat-block-zh { font-family: "Noto Serif SC", serif; font-weight: 400; font-size: 0.95rem; opacity: 0.85; }
  .stat-block-body {
    background: #fffdf7;
    margin: 0;
    padding: 1rem 1.2rem;
    font-size: 0.82rem;
    line-height: 1.65;
    white-space: pre-wrap;
    word-break: break-word;
    font-family: Georgia, serif;
    border-top: 3px solid #c9a96e;
    color: var(--ink);
  }
</style>
