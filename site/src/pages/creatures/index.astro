---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CreatureCard from '../../components/CreatureCard.astro';
import { CATEGORY_LABELS, CATEGORY_ORDER } from '../../utils/taxonomy';

const creatures = await getCollection('creatures');
const byCategory = new Map<string, typeof creatures>();
for (const c of creatures) {
  const list = byCategory.get(c.data.taxonomy.category) ?? [];
  list.push(c);
  byCategory.set(c.data.taxonomy.category, list);
}
const groups = CATEGORY_ORDER
  .filter(cat => byCategory.has(cat))
  .map(cat => ({
    cat,
    label: CATEGORY_LABELS[cat],
    items: (byCategory.get(cat) ?? []).sort((a, b) => a.data.id.localeCompare(b.data.id)),
  }));
---
<Base title="All Creatures — The Chinese Bestiary" description="Every mythical creature cataloged in the Classic of Mountains and Seas (山海经): original texts, new translations, historical illustrations, and D&D 5E stat blocks." wide={true}>
  <h2>All Creatures <span class="zh">神兽总目</span></h2>
  <p>Every entry in the bestiary, grouped by kind. Looking for something specific? Search any name in the box above.</p>
  <nav class="toc" aria-label="Jump to category">
    {groups.map(g => (
      <a href={`#${g.cat}`} class="toc-pill" data-category={g.cat}>
        {g.label} <span class="toc-count">{g.items.length}</span>
      </a>
    ))}
  </nav>
  {groups.map(g => (
    <section id={g.cat}>
      <h3 class="cat-heading" data-category={g.cat}>{g.label}</h3>
      <div class="grid">
        {g.items.map(c => <CreatureCard creature={c} />)}
      </div>
    </section>
  ))}
</Base>

<style>
  .toc { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1.2rem 0 2rem; padding: 0; }
  .toc-pill {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.3rem 0.85rem; border-radius: 2rem;
    font-size: 0.82rem; text-decoration: none;
    border: 1.5px solid var(--pill-color, var(--gold));
    color: var(--pill-color, var(--gold));
    transition: background 0.15s, color 0.15s;
  }
  .toc-pill:hover { background: var(--pill-color, var(--gold)); color: #fff; }
  .toc-pill[data-category="divine_beast"]     { --pill-color: var(--cat-divine); }
  .toc-pill[data-category="fierce_beast"]     { --pill-color: var(--cat-fierce); }
  .toc-pill[data-category="auspicious_beast"] { --pill-color: var(--cat-auspicious); }
  .toc-pill[data-category="deity"]            { --pill-color: var(--cat-deity); }
  .toc-pill[data-category="strange_being"]    { --pill-color: var(--cat-strange); }
  .toc-pill[data-category="hybrid"]           { --pill-color: var(--cat-hybrid); }
  .toc-count { font-size: 0.75rem; opacity: 0.7; }

  .cat-heading {
    border-left: 4px solid var(--cat-color, var(--gold));
    border-bottom: none;
    padding-left: 0.7rem;
    margin-bottom: 0.8rem;
  }
  .cat-heading[data-category="divine_beast"]     { --cat-color: var(--cat-divine); }
  .cat-heading[data-category="fierce_beast"]     { --cat-color: var(--cat-fierce); }
  .cat-heading[data-category="auspicious_beast"] { --cat-color: var(--cat-auspicious); }
  .cat-heading[data-category="deity"]            { --cat-color: var(--cat-deity); }
  .cat-heading[data-category="strange_being"]    { --cat-color: var(--cat-strange); }
  .cat-heading[data-category="hybrid"]           { --cat-color: var(--cat-hybrid); }

  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(175px, 1fr)); gap: 1.25rem; margin: 0 0 2.5rem; }
</style>
