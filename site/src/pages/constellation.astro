---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const [creatures, stories, versuses] = await Promise.all([
  getCollection('creatures'),
  getCollection('stories'),
  getCollection('versus'),
]);

const creatureIds = new Set(creatures.map(c => c.data.id));

const nodeList = creatures.map(c => ({
  id: c.data.id,
  en: c.data.name.en,
  zh: c.data.name.zh_cn,
  element: String((c.data as any).taxonomy?.element ?? 'none'),
  category: String((c.data as any).taxonomy?.category ?? 'divine_beast'),
}));

const edgeMap = new Map<string, { source: string; target: string; type: string; labels: string[] }>();
const EDGE_PRIORITY: Record<string, number> = { versus: 3, story: 2, related: 1 };

function addEdge(a: string, b: string, type: string, label?: string) {
  if (!creatureIds.has(a) || !creatureIds.has(b) || a === b) return;
  const key = [a, b].sort().join('|');
  if (!edgeMap.has(key)) {
    edgeMap.set(key, { source: a, target: b, type, labels: label ? [label] : [] });
  } else {
    const e = edgeMap.get(key)!;
    if ((EDGE_PRIORITY[type] ?? 0) > (EDGE_PRIORITY[e.type] ?? 0)) e.type = type;
    if (label && !e.labels.includes(label)) e.labels.push(label);
  }
}

for (const c of creatures) {
  const rel: string[] = (c.data as any).seo?.related_entries ?? [];
  for (const r of rel) addEdge(c.data.id, r, 'related');
}
for (const s of stories) {
  const rc: string[] = (s.data as any).related_creatures ?? [];
  const storyTitle: string = (s.data as any).title ?? '';
  for (let i = 0; i < rc.length; i++)
    for (let j = i + 1; j < rc.length; j++)
      addEdge(rc[i], rc[j], 'story', storyTitle);
}
for (const v of versuses) {
  const fa = String((v.data as any).fighter_a);
  const fb = String((v.data as any).fighter_b);
  const vsTitle: string = (v.data as any).title ?? '';
  addEdge(fa, fb, 'versus', vsTitle);
}

const linkList = Array.from(edgeMap.values());

const deg: Record<string, number> = {};
for (const n of nodeList) deg[n.id] = 0;
for (const l of linkList) {
  deg[l.source] = (deg[l.source] ?? 0) + 1;
  deg[l.target] = (deg[l.target] ?? 0) + 1;
}

const graphNodes = nodeList.map(n => ({ ...n, degree: deg[n.id] ?? 0 }));
const graphData = JSON.stringify({ nodes: graphNodes, links: linkList })
  .replace(/</g, '\\u003c').replace(/>/g, '\\u003e').replace(/&/g, '\\u0026');

const allElements = [...new Set(graphNodes.map(n => n.element))].filter(e => e !== 'none').sort();
const allCategories = [...new Set(graphNodes.map(n => n.category))].sort();

const ELEMENT_DISPLAY: Record<string, string> = {
  fire: 'Fire 火', water: 'Water 水', wood: 'Wood 木', metal: 'Metal 金',
  earth: 'Earth 土', thunder: 'Thunder 雷', wind: 'Wind 风',
  light: 'Light 光', darkness: 'Darkness 暗', none: 'Other',
};
const CAT_DISPLAY: Record<string, string> = {
  divine_beast: 'Divine Beast 神兽', fierce_beast: 'Fierce Beast 凶兽',
  auspicious_beast: 'Auspicious 瑞兽', deity: 'Deity 神',
  strange_being: 'Strange Being 异物', hybrid: 'Hybrid 混合',
};

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Constellation Map — The Chinese Bestiary",
  "description": "Interactive relationship map of 53 mythological creatures from the Shanhaijing, connected across 162 relationships. Explore clusters like the Four Divine Beasts, the Four Fiends, and the Solar-Celestial group.",
  "url": "https://chinesebestiary.com/constellation/",
  "about": { "@type": "Thing", "name": "Chinese mythology" }
};
---

<Base
  title="Constellation Map 星图 — The Chinese Bestiary"
  description="Interactive map of 53 creatures and their mythological relationships — 162 connections across the Shanhaijing. Explore divine beast clusters, fierce beast feuds, and celestial networks."
  image="/images/og-default.jpg"
  wide={true}
>
  <script type="application/ld+json" set:html={JSON.stringify(pageJsonLd)} />

  <h1>Constellation Map <span class="zh">星图</span></h1>
  <p class="intro">
    {graphNodes.length} creatures, {linkList.length} connections — mapped from their relationships in the
    <em>Shanhaijing</em>, myths, and battles. Hover to trace connections. Click to enter a creature's story.
  </p>

  <div class="controls-wrap">
    <div class="search-wrap">
      <input
        type="search"
        id="creature-search"
        class="search-input"
        placeholder="Search by name…"
        aria-label="Search creatures"
        autocomplete="off"
      />
      <button id="reset-zoom" class="reset-btn" title="Reset zoom to fit all nodes">⊙ Reset</button>
      <button id="mobile-list-toggle" class="mobile-toggle-btn" aria-expanded="false">☰ List view</button>
    </div>
    <div class="filter-row">
      <span class="filter-label">Element:</span>
      <button class="filter-btn active" data-group="element" data-value="">All</button>
      {allElements.map(el => (
        <button class="filter-btn" data-group="element" data-value={el}>
          {ELEMENT_DISPLAY[el] ?? el}
        </button>
      ))}
      <button class="filter-btn" data-group="element" data-value="none">Other</button>
    </div>
    <div class="filter-row">
      <span class="filter-label">Category:</span>
      <button class="filter-btn active" data-group="category" data-value="">All</button>
      {allCategories.map(cat => (
        <button class="filter-btn" data-group="category" data-value={cat}>
          {CAT_DISPLAY[cat] ?? cat}
        </button>
      ))}
    </div>
  </div>

  <div id="constellation-container" class="constellation-panel">
    <div id="graph-loading" class="graph-loading">
      <span>Loading star map…</span>
    </div>
    <noscript>
      <div style="padding: 1.5rem; color: #faf8f3;">
        <p style="margin-bottom: 1rem; opacity: 0.7;">Enable JavaScript for the interactive map. All creatures listed below:</p>
        <ul style="list-style: none; padding: 0; columns: 3; gap: 1rem;">
          {graphNodes.sort((a, b) => a.en.localeCompare(b.en)).map(n => (
            <li style="break-inside: avoid; margin-bottom: 0.4rem;">
              <a href={`/creatures/${n.id}/`} style="color: #d4a853; text-decoration: none; font-size: 0.85rem;">
                {n.en} <span style="opacity: 0.6; font-family: serif;">{n.zh}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </noscript>
  </div>

  <div id="mobile-creature-list" class="mobile-creature-list" hidden>
    {[
      { key: 'divine_beast',     label: 'Divine Beasts 神兽' },
      { key: 'auspicious_beast', label: 'Auspicious Beasts 瑞兽' },
      { key: 'fierce_beast',     label: 'Fierce Beasts 凶兽' },
      { key: 'deity',            label: 'Deities 神' },
      { key: 'strange_being',    label: 'Strange Beings 异物' },
      { key: 'hybrid',           label: 'Hybrid 混合' },
    ].map(({ key, label }) => {
      const group = graphNodes.filter(n => n.category === key).sort((a, b) => a.en.localeCompare(b.en));
      return group.length > 0 ? (
        <div class="ml-group">
          <h3 class="ml-heading">{label}</h3>
          <ul class="ml-list">
            {group.map(n => (
              <li><a href={`/creatures/${n.id}/`}>{n.en} <span class="zh">{n.zh}</span></a></li>
            ))}
          </ul>
        </div>
      ) : null;
    })}
  </div>

  <div class="legend-wrap">
    <div class="legend-group">
      <span class="legend-title">Element color</span>
      <div class="legend-items">
        <span class="legend-dot" style="background:#e74c3c"></span><span>Fire</span>
        <span class="legend-dot" style="background:#5dade2"></span><span>Water</span>
        <span class="legend-dot" style="background:#52be80"></span><span>Wood</span>
        <span class="legend-dot" style="background:#aab7b8"></span><span>Metal</span>
        <span class="legend-dot" style="background:#e59866"></span><span>Earth</span>
        <span class="legend-dot" style="background:#bb8fce"></span><span>Thunder</span>
        <span class="legend-dot" style="background:#48c9b0"></span><span>Wind</span>
        <span class="legend-dot" style="background:#f7dc6f"></span><span>Light</span>
        <span class="legend-dot" style="background:#6c7a89"></span><span>Darkness</span>
        <span class="legend-dot" style="background:#95a5a6"></span><span>Other</span>
      </div>
    </div>
    <div class="legend-group">
      <span class="legend-title">Category ring</span>
      <div class="legend-items">
        <span class="legend-ring" style="border-color:#d4a853"></span><span>Divine Beast</span>
        <span class="legend-ring" style="border-color:#e74c3c"></span><span>Fierce Beast</span>
        <span class="legend-ring" style="border-color:#52be80"></span><span>Auspicious</span>
        <span class="legend-ring" style="border-color:#bb8fce"></span><span>Deity</span>
        <span class="legend-ring" style="border-color:#5dade2"></span><span>Strange Being</span>
        <span class="legend-ring" style="border-color:#e59866"></span><span>Hybrid</span>
      </div>
    </div>
    <div class="legend-group">
      <span class="legend-title">Node size</span>
      <div class="legend-items">
        <span class="legend-circle" style="width:10px;height:10px;margin-right:4px"></span><span>Fewer connections</span>
        <span class="legend-circle" style="width:18px;height:18px;margin-right:4px"></span><span>More connections</span>
      </div>
    </div>
    <div class="legend-group">
      <span class="legend-title">Connection type</span>
      <div class="legend-items">
        <span class="legend-line" style="background:rgba(180,155,80,0.8)"></span><span>Related entry</span>
        <span class="legend-line" style="background:#5090e0"></span><span>Same story</span>
        <span class="legend-line" style="background:#e05050"></span><span>Battle</span>
      </div>
    </div>
  </div>

  <div class="hint-text">
    Scroll or pinch to zoom · Drag to pan · Hover to highlight connections · Click to open creature
  </div>

  <script type="application/json" id="graph-data" set:html={graphData}></script>

  <script is:inline>
  (function () {
    var ELEMENT_COLOR = {
      fire: '#e74c3c', water: '#5dade2', wood: '#52be80', metal: '#aab7b8',
      earth: '#e59866', thunder: '#bb8fce', wind: '#48c9b0',
      light: '#f7dc6f', darkness: '#6c7a89', none: '#95a5a6'
    };
    var CATEGORY_STROKE = {
      divine_beast: '#d4a853', fierce_beast: '#e74c3c',
      auspicious_beast: '#52be80', deity: '#bb8fce',
      strange_being: '#5dade2', hybrid: '#e59866'
    };

    function nodeR(d) {
      return Math.max(5, Math.min(18, 5 + Math.sqrt(d.degree) * 3.2));
    }
    function nodeColor(d) { return ELEMENT_COLOR[d.element] || '#95a5a6'; }
    function nodeStroke(d) { return CATEGORY_STROKE[d.category] || '#888'; }
    function linkStroke(d) {
      return d.type === 'versus' ? 'rgba(200,60,60,0.40)'
           : d.type === 'story'  ? 'rgba(80,130,200,0.38)'
           :                        'rgba(180,155,80,0.22)';
    }
    function linkStrokeHover(d) {
      return d.type === 'versus' ? '#e05050'
           : d.type === 'story'  ? '#5090e0'
           :                        '#d4a853';
    }

    var activeFilters = { element: '', category: '' };
    var svg, g, linkSel, nodeSel, zoom, W, H, nodes, links, tooltip;

    function loadD3() {
      var s = document.createElement('script');
      s.src = '/js/d3.min.js';
      s.onload = initGraph;
      s.onerror = function () {
        document.getElementById('graph-loading').textContent = 'Could not load map library.';
      };
      document.head.appendChild(s);
    }

    function initGraph() {
      var raw = JSON.parse(document.getElementById('graph-data').textContent || '{}');
      nodes = raw.nodes || [];
      links = raw.links || [];

      var container = document.getElementById('constellation-container');
      W = container.clientWidth || 800;
      H = Math.max(Math.min(W * 0.68, 700), 380);
      container.style.height = H + 'px';

      svg = d3.select('#constellation-container')
        .append('svg')
        .attr('width', W)
        .attr('height', H)
        .attr('role', 'img')
        .attr('aria-label', 'Interactive constellation map of Chinese mythological creatures');

      // starfield dots
      var starG = svg.append('g').attr('class', 'stars');
      for (var i = 0; i < 120; i++) {
        starG.append('circle')
          .attr('cx', Math.random() * W)
          .attr('cy', Math.random() * H)
          .attr('r', Math.random() * 1.2 + 0.3)
          .attr('fill', 'rgba(255,255,255,' + (Math.random() * 0.25 + 0.05) + ')');
      }

      g = svg.append('g');

      zoom = d3.zoom()
        .scaleExtent([0.12, 5])
        .on('zoom', function (event) { g.attr('transform', event.transform); });
      svg.call(zoom);

      var sim = d3.forceSimulation(nodes)
        .force('link', d3.forceLink(links).id(function (d) { return d.id; }).distance(70).strength(0.5))
        .force('charge', d3.forceManyBody().strength(-320).distanceMax(350))
        .force('center', d3.forceCenter(W / 2, H / 2))
        .force('collision', d3.forceCollide().radius(function (d) { return nodeR(d) + 9; }))
        .stop();

      for (var tick = 0; tick < 500; tick++) sim.tick();

      // fit to bounds
      var xs = nodes.map(function (n) { return n.x; });
      var ys = nodes.map(function (n) { return n.y; });
      var minX = Math.min.apply(null, xs), maxX = Math.max.apply(null, xs);
      var minY = Math.min.apply(null, ys), maxY = Math.max.apply(null, ys);
      var pad = 48;
      var scaleX = (W - pad * 2) / (maxX - minX || 1);
      var scaleY = (H - pad * 2) / (maxY - minY || 1);
      var initScale = Math.min(scaleX, scaleY, 1.6);
      var initTx = (W - initScale * (minX + maxX)) / 2;
      var initTy = (H - initScale * (minY + maxY)) / 2;
      svg.call(zoom.transform, d3.zoomIdentity.translate(initTx, initTy).scale(initScale));

      // store for reset button
      var initTransform = d3.zoomIdentity.translate(initTx, initTy).scale(initScale);

      // draw links
      linkSel = g.append('g').attr('class', 'links')
        .selectAll('line')
        .data(links)
        .join('line')
        .attr('stroke', linkStroke)
        .attr('stroke-width', 1)
        .attr('x1', function (d) { return d.source.x; })
        .attr('y1', function (d) { return d.source.y; })
        .attr('x2', function (d) { return d.target.x; })
        .attr('y2', function (d) { return d.target.y; });

      // draw nodes
      nodeSel = g.append('g').attr('class', 'nodes')
        .selectAll('g')
        .data(nodes)
        .join('g')
        .attr('class', 'node-g')
        .attr('transform', function (d) { return 'translate(' + d.x + ',' + d.y + ')'; })
        .attr('tabindex', 0)
        .attr('role', 'button')
        .attr('aria-label', function (d) { return d.en + ' (' + d.zh + ')'; });

      nodeSel.append('circle')
        .attr('r', nodeR)
        .attr('fill', nodeColor)
        .attr('stroke', nodeStroke)
        .attr('stroke-width', 2.2)
        .attr('fill-opacity', 0.82)
        .style('cursor', 'pointer');

      // labels for high-degree nodes always visible
      nodeSel.append('text')
        .attr('class', 'node-label')
        .attr('dy', function (d) { return nodeR(d) + 11; })
        .attr('text-anchor', 'middle')
        .attr('font-size', '8.5px')
        .attr('fill', '#faf8f3')
        .attr('fill-opacity', function (d) { return d.degree >= 5 ? 0.85 : 0; })
        .style('pointer-events', 'none')
        .style('font-family', 'Georgia, serif')
        .text(function (d) {
          var parts = d.en.split(' ');
          return parts.length > 2 ? parts.slice(0, 2).join(' ') : d.en;
        });

      // tooltip element
      tooltip = document.getElementById('star-tooltip');

      // interactions
      nodeSel
        .on('mouseenter', onNodeEnter)
        .on('mousemove', onNodeMove)
        .on('mouseleave', onNodeLeave)
        .on('click', function (event, d) {
          event.stopPropagation();
          window.location.href = '/creatures/' + d.id + '/';
        })
        .on('keydown', function (event, d) {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            window.location.href = '/creatures/' + d.id + '/';
          }
        });

      // dismiss tooltip on svg click
      svg.on('click', function () { hideTooltip(); });

      document.getElementById('graph-loading').style.display = 'none';
      addClusterLabels();
      setupFilters();
      setupSearch();
      setupResetButton(initTransform);
      setupMobileToggle();
    }

    function onNodeEnter(event, d) {
      var neighborIds = buildNeighborIds(d.id);

      nodeSel.transition().duration(120)
        .attr('opacity', function (n) { return neighborIds.has(n.id) ? 1 : 0.12; });

      linkSel.transition().duration(120)
        .attr('stroke', function (l) {
          var sid = l.source.id || l.source;
          var tid = l.target.id || l.target;
          return (sid === d.id || tid === d.id) ? linkStrokeHover(l) : 'rgba(60,50,30,0.15)';
        })
        .attr('stroke-width', function (l) {
          var sid = l.source.id || l.source;
          var tid = l.target.id || l.target;
          return (sid === d.id || tid === d.id) ? 2 : 0.8;
        });

      showTooltip(event, d, neighborIds.size - 1);
    }

    function onNodeMove(event) {
      if (tooltip) {
        tooltip.style.left = (event.clientX + 14) + 'px';
        tooltip.style.top = (event.clientY - 36) + 'px';
      }
    }

    function onNodeLeave() {
      applyFilters();
      hideTooltip();
    }

    function buildNeighborIds(id) {
      var set = new Set([id]);
      links.forEach(function (l) {
        var s = l.source.id || l.source;
        var t = l.target.id || l.target;
        if (s === id) set.add(t);
        if (t === id) set.add(s);
      });
      return set;
    }

    function showTooltip(event, d, connCount) {
      if (!tooltip) return;
      var catLabel = {
        divine_beast: 'Divine Beast', fierce_beast: 'Fierce Beast',
        auspicious_beast: 'Auspicious Beast', deity: 'Deity',
        strange_being: 'Strange Being', hybrid: 'Hybrid'
      }[d.category] || d.category;
      var elLabel = d.element.charAt(0).toUpperCase() + d.element.slice(1);

      // Build relationship breakdown
      var nodeId = d.id;
      var byId = {};
      nodes.forEach(function (n) { byId[n.id] = n; });

      function otherName(l) {
        var sid = l.source.id || l.source, tid = l.target.id || l.target;
        var otherId = sid === nodeId ? tid : sid;
        return byId[otherId] ? byId[otherId].en : otherId;
      }

      var vsLinks    = links.filter(function (l) { var s = l.source.id||l.source, t = l.target.id||l.target; return (s===nodeId||t===nodeId) && l.type==='versus'; });
      var stLinks    = links.filter(function (l) { var s = l.source.id||l.source, t = l.target.id||l.target; return (s===nodeId||t===nodeId) && l.type==='story'; });
      var relLinks   = links.filter(function (l) { var s = l.source.id||l.source, t = l.target.id||l.target; return (s===nodeId||t===nodeId) && l.type==='related'; });

      var relHtml = '';
      vsLinks.forEach(function (l) {
        var lbl = l.labels && l.labels[0] ? l.labels[0].replace(/ — .*/, '').substring(0, 32) : '';
        relHtml += '<div style="color:#e07070;font-size:0.73rem;margin-top:2px">⚔ vs ' + otherName(l) + (lbl ? ' <span style="opacity:0.65">— ' + lbl + '</span>' : '') + '</div>';
      });
      if (stLinks.length > 0) {
        var stLabel = stLinks[0].labels && stLinks[0].labels[0] ? stLinks[0].labels[0].substring(0, 28) + (stLinks[0].labels[0].length > 28 ? '…' : '') : '';
        var stNames = stLinks.slice(0, 3).map(otherName).join(', ') + (stLinks.length > 3 ? ' +' + (stLinks.length-3) : '');
        relHtml += '<div style="color:#7aace0;font-size:0.73rem;margin-top:2px">↔ ' + stNames + (stLabel ? ' <span style="opacity:0.65">— ' + stLabel + '</span>' : '') + '</div>';
      }
      if (relLinks.length > 0) {
        var relNames = relLinks.slice(0, 4).map(otherName).join(', ') + (relLinks.length > 4 ? ' +' + (relLinks.length-4) : '');
        relHtml += '<div style="color:#c8b870;font-size:0.73rem;opacity:0.75;margin-top:2px">～ ' + relNames + '</div>';
      }

      tooltip.innerHTML =
        '<strong style="font-family:\'Cinzel\',serif;font-size:0.9rem">' + d.en + '</strong>' +
        ' <span style="font-family:serif;opacity:0.75;font-size:0.85rem">' + d.zh + '</span>' +
        '<br><small style="opacity:0.65">' + catLabel + ' · ' + elLabel +
        ' · ' + connCount + ' link' + (connCount !== 1 ? 's' : '') + '</small>' +
        relHtml;
      tooltip.style.left = (event.clientX + 14) + 'px';
      tooltip.style.top = (event.clientY - 36) + 'px';
      tooltip.style.opacity = '1';
    }

    function hideTooltip() {
      if (tooltip) tooltip.style.opacity = '0';
    }

    function applyFilters() {
      if (!nodeSel) return;
      var ef = activeFilters.element;
      var cf = activeFilters.category;

      nodeSel.transition().duration(150)
        .attr('opacity', function (d) {
          if (ef && d.element !== ef) return 0.1;
          if (cf && d.category !== cf) return 0.1;
          return 1;
        });

      linkSel.transition().duration(150)
        .attr('stroke', function (l) {
          if (!ef && !cf) return linkStroke(l);
          var s = l.source.element !== undefined ? l.source : nodes.find(function (n) { return n.id === (l.source.id || l.source); });
          var t = l.target.element !== undefined ? l.target : nodes.find(function (n) { return n.id === (l.target.id || l.target); });
          if (!s || !t) return linkStroke(l);
          var sv = (!ef || s.element === ef) && (!cf || s.category === cf);
          var tv = (!ef || t.element === ef) && (!cf || t.category === cf);
          return (sv && tv) ? linkStroke(l) : 'rgba(80,70,40,0.10)';
        })
        .attr('stroke-width', function (l) {
          if (!ef && !cf) return 1;
          var s = l.source.element !== undefined ? l.source : nodes.find(function (n) { return n.id === (l.source.id || l.source); });
          var t = l.target.element !== undefined ? l.target : nodes.find(function (n) { return n.id === (l.target.id || l.target); });
          if (!s || !t) return 0.3;
          var sv = (!ef || s.element === ef) && (!cf || s.category === cf);
          var tv = (!ef || t.element === ef) && (!cf || t.category === cf);
          return (sv && tv) ? 1 : 0.2;
        });
    }

    function setupFilters() {
      document.querySelectorAll('.filter-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var group = btn.getAttribute('data-group');
          var val = btn.getAttribute('data-value') || '';
          activeFilters[group] = activeFilters[group] === val ? '' : val;

          document.querySelectorAll('.filter-btn[data-group="' + group + '"]').forEach(function (b) {
            b.classList.toggle('active', (b.getAttribute('data-value') || '') === activeFilters[group]);
          });
          applyFilters();
        });
      });
    }

    function setupSearch() {
      var input = document.getElementById('creature-search');
      if (!input) return;
      input.addEventListener('input', function () {
        var q = this.value.trim().toLowerCase();
        if (!q) { applyFilters(); return; }

        var matches = nodes.filter(function (d) {
          return d.en.toLowerCase().includes(q) || d.zh.includes(q);
        });
        var matchSet = new Set(matches.map(function (d) { return d.id; }));

        nodeSel.transition().duration(150)
          .attr('opacity', function (d) { return matchSet.has(d.id) ? 1 : 0.08; });

        linkSel.transition().duration(150)
          .attr('stroke', 'rgba(180,155,80,0.1)');

        nodeSel.selectAll('text.node-label')
          .attr('fill-opacity', function (d) { return matchSet.has(d.id) ? 1 : 0; });

        if (matches.length === 1 && matches[0].x !== undefined) {
          var nd = matches[0];
          var scale = 2.4;
          var tx = W / 2 - scale * nd.x;
          var ty = H / 2 - scale * nd.y;
          svg.transition().duration(600)
            .call(zoom.transform, d3.zoomIdentity.translate(tx, ty).scale(scale));
        }
      });
    }

    function addClusterLabels() {
      var CLUSTERS = [
        { label: 'FOUR SYMBOLS', ids: ['qinglong', 'bai-hu', 'zhu-que', 'xuanwu'] },
        { label: 'FOUR PERILS', ids: ['hundun', 'qiongqi', 'taotie', 'taowu'] },
        { label: 'SOLAR COURT', ids: ['hou-yi', 'chang-e', 'xi-he', 'san-zu-wu', 'di-jun'] },
        { label: 'PRIMORDIAL', ids: ['nuwa', 'gonggong', 'zhurong', 'kua-fu', 'xing-tian'] },
      ];
      var byId = {};
      nodes.forEach(function (n) { byId[n.id] = n; });

      var clData = CLUSTERS.map(function (cl) {
        var members = cl.ids.map(function (id) { return byId[id]; }).filter(Boolean);
        if (members.length < 2) return null;
        var cx = members.reduce(function (s, n) { return s + n.x; }, 0) / members.length;
        var cy = members.reduce(function (s, n) { return s + n.y; }, 0) / members.length;
        return { label: cl.label, x: cx, y: cy };
      }).filter(Boolean);

      g.append('g').attr('class', 'cluster-labels')
        .selectAll('text')
        .data(clData)
        .join('text')
        .attr('x', function (d) { return d.x; })
        .attr('y', function (d) { return d.y; })
        .attr('text-anchor', 'middle')
        .attr('font-size', '8px')
        .attr('font-family', "'Cinzel', Georgia, serif")
        .attr('fill', 'rgba(212,168,83,0.38)')
        .attr('letter-spacing', '0.1em')
        .attr('pointer-events', 'none')
        .text(function (d) { return d.label; });
    }

    function setupResetButton(initTransform) {
      var btn = document.getElementById('reset-zoom');
      if (!btn) return;
      btn.addEventListener('click', function () {
        svg.transition().duration(600).call(zoom.transform, initTransform);
        document.getElementById('creature-search').value = '';
        applyFilters();
      });
    }

    function setupMobileToggle() {
      var btn = document.getElementById('mobile-list-toggle');
      var list = document.getElementById('mobile-creature-list');
      var panel = document.getElementById('constellation-container');
      if (!btn || !list || !panel) return;
      btn.addEventListener('click', function () {
        var showingList = !list.hidden;
        list.hidden = showingList;
        panel.style.display = showingList ? '' : 'none';
        btn.textContent = showingList ? '☰ List view' : '⊙ Map view';
        btn.setAttribute('aria-expanded', String(!showingList));
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', loadD3);
    } else {
      loadD3();
    }
  })();
  </script>

  <div id="star-tooltip" class="star-tooltip"></div>

  <div class="static-links" aria-hidden="true">
    {graphNodes.sort((a, b) => a.en.localeCompare(b.en)).map(n => (
      <a href={`/creatures/${n.id}/`}>{n.en}</a>
    ))}
  </div>
</Base>

