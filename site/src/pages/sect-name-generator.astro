---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SubscribeBand from '../components/SubscribeBand.astro';
import { getCreatureImage } from '../utils/creatureImage';

const CATEGORY_LABELS: Record<string, string> = {
  divine_beast: 'Divine Beast',
  fierce_beast: 'Fierce Beast',
  auspicious_beast: 'Auspicious Beast',
  deity: 'Deity',
  strange_being: 'Strange Being',
  hybrid: 'Hybrid',
};

const beasts = (await getCollection('creatures')).map(c => ({
  slug: c.data.id,
  en: c.data.name.en,
  zh: c.data.name.zh_cn,
  pinyin: c.data.name.pinyin,
  element: c.data.taxonomy.element,
  category: c.data.taxonomy.category,
  categoryLabel: CATEGORY_LABELS[c.data.taxonomy.category] ?? c.data.taxonomy.category,
  image: getCreatureImage(c.data.id),
}));

const title = 'Sect Name Generator — Xianxia Sect & Clan Names with Chinese Meanings';
const description = 'Generate xianxia sect names with real Chinese morphology: classical epithets plus institution words (宗 sect, 宫 palace, 谷 valley), each with pinyin, meaning, and register — orthodox, demonic, mystic, or reclusive.';
---

<Base title={title} description={description} image="/images/creatures/xuanwu.jpg">
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How are xianxia sect names built?",
        "acceptedAnswer": { "@type": "Answer", "text": "Nearly all follow one formula: a two-character epithet (a natural image, a cosmological term, or a moral claim) plus an institution word. The institution word carries the register: 宗 zōng and 派 pài are orthodox mainstream, 教 jiào smells of heterodoxy, 宫 gōng signals wealth and distance, 谷 gǔ means a reclusive valley sect." }
      },
      {
        "@type": "Question",
        "name": "What is the difference between 宗, 门, 派, and 教?",
        "acceptedAnswer": { "@type": "Answer", "text": "宗 zōng is the grand sect, ancestor-founded; 门 mén is the gate, a school with a defined teaching; 派 pài is the lineage or faction; 教 jiào is the teaching — a mass movement, and in fiction often the heterodox or 'demonic' one. Choosing the institution word is choosing the sect's social standing." }
      },
      {
        "@type": "Question",
        "name": "Are these real Chinese words?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes — every epithet is built from attested classical vocabulary: Purple Firmament, Azure Waves, the Nine Netherworlds. Institution words are the real vocabulary of Chinese religious and martial organizations. The combinations are invented, as all fictional sects are." }
      },
      {
        "@type": "Question",
        "name": "Can I use a generated sect name in my novel or game?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. Individual names are not copyrightable and every component is public-domain classical vocabulary. Use them freely for novels, tabletop campaigns, and games." }
      }
    ]
  })} />

  <h1>Sect Name Generator <span class="zh">宗门名生成器</span></h1>

  <p class="lede">Every cultivator answers to a banner. This generator builds xianxia sect names the way Chinese authors build them: a <strong>two-character classical epithet</strong> fused with an <strong>institution word</strong> that quietly announces the sect's social standing — a 宫 is rich and remote, a 谷 is reclusive, an 教 is one sermon away from heresy. Each result comes with pinyin, a literal meaning, and a <strong>patron beast from the Classic of Mountains and Seas</strong>.</p>

  <div class="generator">
    <div class="controls">
      <label>
        Allegiance <span class="zh">正邪</span>
        <select id="gen-style">
          <option value="any">Fate decides</option>
          <option value="orthodox">Orthodox 正道</option>
          <option value="demonic">Demonic 魔道</option>
          <option value="mystic">Mystic 玄门</option>
          <option value="nature">Reclusive 山水</option>
        </select>
      </label>
      <label>
        Form <span class="zh">建制</span>
        <select id="gen-form">
          <option value="any">Fate decides</option>
          <option value="school">Sects &amp; Schools 宗门派教</option>
          <option value="palace">Palaces &amp; Towers 宫阁楼殿</option>
          <option value="wild">Valleys &amp; Peaks 谷山峰岛</option>
        </select>
      </label>
      <button id="gen-btn" class="forge-btn" type="button">Found a Sect <span class="zh">立派</span></button>
    </div>

    <div class="result" id="gen-result" hidden>
      <div class="result-main">
        <div class="seal" aria-hidden="true">宗</div>
        <div class="result-name-block">
          <div class="result-zh zh" id="r-zh">—</div>
          <div class="result-pinyin" id="r-pinyin"></div>
          <div class="result-gloss" id="r-gloss"></div>
        </div>
      </div>
      <dl class="result-meta">
        <div><dt>Allegiance</dt><dd id="r-style"></dd></div>
        <div><dt>Institution</dt><dd id="r-inst"></dd></div>
        <div><dt>Register</dt><dd id="r-register"></dd></div>
      </dl>
      <div class="guardian" id="r-guardian"></div>
      <div class="result-actions">
        <button id="copy-btn" class="ghost-btn" type="button">Copy result</button>
        <button id="again-btn" class="ghost-btn" type="button">Found another</button>
      </div>
    </div>

    <div class="history" id="gen-history" hidden>
      <h3>Previous sects <span class="zh">前尘</span></h3>
      <ul id="history-list"></ul>
    </div>
  </div>

  <h3>How sect names work <span class="zh">立派之道</span></h3>
  <p>A xianxia sect name is one formula with two moving parts. The <strong>epithet</strong> is the claim: a celestial image (Purple Firmament 紫霄), a moral banner (Flood-like Righteousness 浩然, straight from Mencius), or a threat (Blood River 血河). The <strong>institution word</strong> is the social register — and it is doing more work than the epithet. 宗 and 派 are respectable. 宫 and 殿 are old money. 阁 and 楼 sell information in the jianghu. 谷 and 岛 are recluses. And 教 — the "Teaching" — is where fiction parks its heterodox movements, from the White Lotus to every demonic cult in web novels.</p>
  <p>The demonic register has its own grammar: erosion verbs, netherworld nouns, negation. 幽冥 (Netherdark), 九幽 (the Nine Netherworlds), 白骨 (White Bone) — a righteous sect is named for what it reveres; a demonic sect is named for what it consumes. Meanwhile the reclusive schools take landscape names — Listening-to-Snow, Azure Waves — because in the logic of the genre, the mountain <em>is</em> the sect.</p>
  <p>Founding a sect for a story? Name its members with the <a href="/cultivator-name-generator/">Cultivator Name Generator</a>, give the founder a title with the <a href="/name-generator/">Dao Hao Generator</a>, and arm them with the <a href="/sword-name-generator/">Sword Name Generator</a>.</p>

  <h3>FAQ</h3>
  <details>
    <summary>How are xianxia sect names built?</summary>
    <p>Nearly all follow one formula: a two-character epithet (a natural image, a cosmological term, or a moral claim) plus an institution word. The institution word carries the register: 宗 zōng and 派 pài are orthodox mainstream, 教 jiào smells of heterodoxy, 宫 gōng signals wealth and distance, 谷 gǔ means a reclusive valley sect.</p>
  </details>
  <details>
    <summary>What is the difference between 宗, 门, 派, and 教?</summary>
    <p>宗 zōng is the grand sect, ancestor-founded; 门 mén is the gate, a school with a defined teaching; 派 pài is the lineage or faction; 教 jiào is the teaching — a mass movement, and in fiction often the heterodox or "demonic" one. Choosing the institution word is choosing the sect's social standing.</p>
  </details>
  <details>
    <summary>Are these real Chinese words?</summary>
    <p>Yes — every epithet is attested classical vocabulary (Purple Firmament, Azure Waves, the Nine Netherworlds), and the institution words are the real vocabulary of Chinese religious and martial organizations. The combinations are invented, as all fictional sects are.</p>
  </details>
  <details>
    <summary>Can I use a generated sect name in my novel or game?</summary>
    <p>Yes — names are not copyrightable and every component is public-domain classical vocabulary. Use freely.</p>
  </details>

  <SubscribeBand />
</Base>

<script type="application/json" id="gen-data" set:html={JSON.stringify({ beasts })}></script>

<script is:inline>
(function () {
  var data = JSON.parse(document.getElementById('gen-data').textContent);
  var beasts = data.beasts;

  // [zh, pinyin, gloss]
  var STYLES = {
    orthodox: {
      label: 'Orthodox 正道',
      cats: ['auspicious_beast', 'divine_beast'],
      epithets: [
        ['紫霄', 'Zǐxiāo', 'Purple Firmament'],
        ['太一', 'Tàiyī', 'Supreme One'],
        ['浩然', 'Hàorán', 'Flood-like Righteousness (Mencius)'],
        ['三清', 'Sānqīng', 'Three Pure Ones'],
        ['天柱', 'Tiānzhù', "Heaven's Pillar"],
        ['明镜', 'Míngjìng', 'Bright Mirror'],
        ['苍梧', 'Cāngwú', 'Green Wu Mountain, where the sage-king Shun died'],
        ['正一', 'Zhèngyī', 'Orthodox Unity (a real Daoist lineage)'],
        ['崇真', 'Chóngzhēn', 'Venerating Truth'],
        ['明德', 'Míngdé', 'Luminous Virtue (Great Learning)']
      ]
    },
    demonic: {
      label: 'Demonic 魔道',
      cats: ['fierce_beast'],
      epithets: [
        ['幽冥', 'Yōumíng', 'Netherdark'],
        ['血河', 'Xuèhé', 'Blood River'],
        ['万魂', 'Wànhún', 'Ten Thousand Souls'],
        ['蚀日', 'Shírì', 'Sun-Devouring'],
        ['九幽', 'Jiǔyōu', 'Nine Netherworlds'],
        ['白骨', 'Báigǔ', 'White Bone'],
        ['玄阴', 'Xuányīn', 'Mysterious Yin'],
        ['黄泉', 'Huángquán', 'Yellow Springs (the underworld)'],
        ['吞灵', 'Tūnlíng', 'Spirit-Devouring'],
        ['断生', 'Duànshēng', 'Life-Severing']
      ]
    },
    mystic: {
      label: 'Mystic 玄门',
      cats: ['deity'],
      epithets: [
        ['玄机', 'Xuánjī', 'Arcane Mechanism'],
        ['紫微', 'Zǐwēi', 'Purple Tenuity (the imperial star palace)'],
        ['太乙', 'Tàiyǐ', 'Grand Unity'],
        ['星枢', 'Xīngshū', 'Star Pivot'],
        ['河洛', 'Héluò', 'River Chart and Luo Writing (河图洛书)'],
        ['先天', 'Xiāntiān', 'Prior Heaven'],
        ['太玄', 'Tàixuán', 'Grand Mystery'],
        ['玉宸', 'Yùchén', 'Jade Firmament'],
        ['灵宝', 'Língbǎo', 'Numinous Treasure (the Daoist canon section)'],
        ['洞真', 'Dòngzhēn', 'Cavern of Truth']
      ]
    },
    nature: {
      label: 'Reclusive 山水',
      cats: ['hybrid', 'strange_being', 'auspicious_beast'],
      epithets: [
        ['听雪', 'Tīngxuě', 'Listening to Snow'],
        ['流云', 'Liúyún', 'Drifting Clouds'],
        ['青梧', 'Qīngwú', 'Green Wutong (where phoenixes perch)'],
        ['沧浪', 'Cānglàng', 'Azure Waves (the fisherman\u2019s song)'],
        ['栖霞', 'Qīxiá', 'Roosting Rosy Clouds'],
        ['空翠', 'Kōngcuì', 'Empty Verdure (Wang Wei: "空翠湿人衣")'],
        ['寒山', 'Hánshān', 'Cold Mountain (the poet-monk)'],
        ['溪云', 'Xīyún', 'Stream Clouds'],
        ['松风', 'Sōngfēng', 'Wind in the Pines'],
        ['竹坞', 'Zhúwù', 'Bamboo Hollow']
      ]
    }
  };

  // [zh, pinyin, translation, register-note, form]
  var INSTITUTIONS = [
    ['宗', 'zōng', 'Sect', 'The grand, ancestor-founded sect — orthodox mainstream register', 'school'],
    ['门', 'mén', 'Gate', 'A school with a defined teaching; the workhorse institution word', 'school'],
    ['派', 'pài', 'School', 'A lineage or faction — signals internal politics and inheritance', 'school'],
    ['教', 'jiào', 'Teaching', 'A mass movement; in fiction, one sermon away from heresy', 'school'],
    ['宫', 'gōng', 'Palace', 'Old money — wealthy, remote, above the fray', 'palace'],
    ['阁', 'gé', 'Pavilion', 'Refined and scholarly; jianghu information-dealers live here', 'palace'],
    ['楼', 'lóu', 'Tower', 'The jianghu flavor — intelligence networks and assassins', 'palace'],
    ['殿', 'diàn', 'Hall', 'Grand and temple-adjacent; ritual gravity', 'palace'],
    ['谷', 'gǔ', 'Valley', 'Reclusive — the sect is the place, and the place is hidden', 'wild'],
    ['山', 'shān', 'Mountain', 'The mountain IS the sect; oldest register in the genre', 'wild'],
    ['峰', 'fēng', 'Peak', 'Sword-sect flavor — sharp, vertical, proud', 'wild'],
    ['岛', 'dǎo', 'Island', 'Overseas immortal realm, beyond the mainland\u2019s laws', 'wild']
  ];

  function pick(arr) { return arr[Math.floor(Math.random() * arr.length)]; }

  function generate() {
    var styleId = document.getElementById('gen-style').value;
    var formId = document.getElementById('gen-form').value;
    var styleKey = styleId === 'any' ? pick(['orthodox', 'demonic', 'mystic', 'nature']) : styleId;
    var style = STYLES[styleKey];

    var ep = pick(style.epithets);
    var instPool = formId === 'any' ? INSTITUTIONS : INSTITUTIONS.filter(function (i) { return i[4] === formId; });
    var inst = pick(instPool);

    var guardianPool = beasts.filter(function (b) { return style.cats.indexOf(b.category) !== -1; });
    var guardian = guardianPool.length ? pick(guardianPool) : pick(beasts);

    return {
      zh: ep[0] + inst[0],
      pinyin: ep[1] + ' ' + inst[1],
      gloss: ep[2] + ' ' + inst[2],
      styleLabel: style.label,
      instLabel: inst[0] + ' ' + inst[1] + ' (' + inst[2] + ')',
      register: inst[3],
      guardian: guardian
    };
  }

  var history = [];

  function render(r) {
    document.getElementById('r-zh').textContent = r.zh;
    document.getElementById('r-pinyin').textContent = r.pinyin;
    document.getElementById('r-gloss').textContent = r.gloss;
    document.getElementById('r-style').textContent = r.styleLabel;
    document.getElementById('r-inst').textContent = r.instLabel;
    document.getElementById('r-register').textContent = r.register;

    var g = r.guardian;
    var el = document.getElementById('r-guardian');
    el.innerHTML = '';
    var card = document.createElement('a');
    card.href = '/creatures/' + g.slug + '/';
    card.className = 'guardian-card';
    if (g.image) {
      var img = document.createElement('img');
      img.src = g.image;
      img.alt = g.en;
      img.width = 72; img.height = 72;
      card.appendChild(img);
    }
    var info = document.createElement('div');
    info.className = 'guardian-info';
    var t1 = document.createElement('div');
    t1.className = 'guardian-name';
    t1.innerHTML = 'Patron beast: <strong>' + g.en + ' <span class="zh">' + g.zh + '</span></strong>';
    var t2 = document.createElement('div');
    t2.className = 'guardian-sub';
    t2.textContent = g.categoryLabel + ' · ' + g.pinyin;
    var t3 = document.createElement('div');
    t3.className = 'guardian-link';
    t3.textContent = 'Read its original Shanhaijing entry →';
    info.appendChild(t1); info.appendChild(t2); info.appendChild(t3);
    card.appendChild(info);
    el.appendChild(card);

    document.getElementById('gen-result').hidden = false;
    document.getElementById('gen-result').scrollIntoView({ behavior: 'smooth', block: 'nearest' });

    history.unshift(r);
    if (history.length > 5) history.pop();
    renderHistory();
  }

  function renderHistory() {
    var box = document.getElementById('gen-history');
    var list = document.getElementById('history-list');
    list.innerHTML = '';
    history.forEach(function (r) {
      var li = document.createElement('li');
      li.innerHTML = '<span class="zh">' + r.zh + '</span> <em>' + r.pinyin + '</em> — ' + r.gloss;
      list.appendChild(li);
    });
    box.hidden = history.length === 0;
  }

  function copyResult() {
    if (!history.length) return;
    var r = history[0];
    var g = r.guardian;
    var text = r.zh + ' ' + r.pinyin + ' — ' + r.gloss +
      ' · ' + r.register +
      ' · Patron beast: ' + g.en + ' (' + g.zh + ')' +
      ' https://chinesebestiary.com/creatures/' + g.slug + '/';
    var done = function () {
      var btn = document.getElementById('copy-btn');
      btn.textContent = 'Copied!';
      setTimeout(function () { btn.textContent = 'Copy result'; }, 1500);
    };
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(done, function () { fallbackCopy(text); done(); });
    } else {
      fallbackCopy(text); done();
    }
  }

  function fallbackCopy(text) {
    var ta = document.createElement('textarea');
    ta.value = text;
    document.body.appendChild(ta);
    ta.select();
    try { document.execCommand('copy'); } catch (e) {}
    document.body.removeChild(ta);
  }

  document.getElementById('gen-btn').addEventListener('click', function () {
    if (typeof gtag === 'function') gtag('event', 'generate_name', { tool: 'sect' });
    render(generate());
  });
  document.getElementById('again-btn').addEventListener('click', function () {
    if (typeof gtag === 'function') gtag('event', 'generate_name', { tool: 'sect' });
    render(generate());
  });
  document.getElementById('copy-btn').addEventListener('click', copyResult);
})();
</script>

<style>
  .lede { font-size: 0.97rem; }
  .generator { background: #fff; border: 1px solid #e0d9c8; border-radius: 4px; padding: 1.5rem; margin: 1.5rem 0; }
  .controls { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; align-items: flex-end; }
  .controls label { display: flex; flex-direction: column; gap: 0.3rem; font-size: 0.85rem; color: var(--mist); }
  .controls select {
    font-family: Georgia, serif; font-size: 0.95rem; padding: 0.45rem 0.6rem;
    border: 1px solid #d8d0bc; border-radius: 3px; background: var(--paper); color: var(--ink);
    min-width: 12rem;
  }
  .forge-btn {
    font-family: 'Cinzel', Georgia, serif; font-size: 1rem; letter-spacing: 0.04em;
    background: var(--vermillion); color: #faf8f3; border: none; border-radius: 3px;
    padding: 0.6rem 1.6rem; cursor: pointer; transition: background 0.15s, transform 0.1s;
  }
  .forge-btn:hover { background: #a5301f; }
  .forge-btn:active { transform: scale(0.98); }
  .forge-btn .zh { font-family: "Noto Serif SC", serif; margin-left: 0.3rem; }

  .result { margin-top: 1.5rem; border-top: 1px solid #e0d9c8; padding-top: 1.5rem; }
  .result-main { display: flex; gap: 1.25rem; align-items: center; }
  .seal {
    flex-shrink: 0; width: 4rem; height: 4rem;
    background: var(--vermillion); color: #faf8f3; border-radius: 4px;
    display: flex; align-items: center; justify-content: center;
    font-family: "Noto Serif SC", serif; font-size: 2.2rem; font-weight: 600;
    box-shadow: 2px 2px 0 rgba(192,57,43,0.25);
  }
  .result-zh { font-size: 2.2rem; font-weight: 600; line-height: 1.2; }
  .result-pinyin { color: var(--vermillion); font-size: 0.95rem; letter-spacing: 0.03em; }
  .result-gloss { color: var(--mist); font-size: 0.9rem; font-style: italic; max-width: 34rem; }
  .result-meta { display: flex; flex-wrap: wrap; gap: 0.75rem 2rem; margin: 1.25rem 0; padding: 0; }
  .result-meta dt { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--mist); }
  .result-meta dd { margin: 0.15rem 0 0; font-size: 0.95rem; max-width: 22rem; }

  .guardian-card {
    display: flex; gap: 1rem; align-items: center; text-decoration: none;
    background: var(--paper); border: 1px solid #e0d9c8; border-radius: 4px;
    padding: 0.9rem 1.1rem; transition: border-color 0.15s, box-shadow 0.15s;
  }
  .guardian-card:hover { border-color: var(--gold); box-shadow: 2px 3px 10px rgba(26,26,46,0.08); }
  .guardian-card img { width: 72px; height: 72px; object-fit: cover; border-radius: 3px; border: 1px solid #e0d9c8; background: #fff; }
  .guardian-name { font-size: 0.95rem; color: var(--ink); }
  .guardian-sub { font-size: 0.82rem; color: var(--mist); }
  .guardian-link { font-size: 0.85rem; color: var(--vermillion); margin-top: 0.2rem; }

  .result-actions { display: flex; gap: 0.75rem; margin-top: 1.25rem; }
  .ghost-btn {
    font-family: Georgia, serif; font-size: 0.88rem; padding: 0.45rem 1.1rem;
    background: transparent; color: var(--ink); border: 1px solid #d8d0bc; border-radius: 3px;
    cursor: pointer; transition: border-color 0.15s, color 0.15s;
  }
  .ghost-btn:hover { border-color: var(--vermillion); color: var(--vermillion); }

  .history { margin-top: 1.5rem; }
  .history h3 { margin-top: 0; }
  .history ul { list-style: none; margin: 0; padding: 0; }
  .history li { font-size: 0.88rem; color: var(--mist); padding: 0.35rem 0; border-bottom: 1px dashed #e0d9c8; }
  .history li .zh { color: var(--ink); }
  .history li em { color: var(--vermillion); font-style: normal; }

  details { border: 1px solid #e0d9c8; border-radius: 4px; padding: 0.7rem 1rem; margin: 0.6rem 0; background: #fff; }
  summary { cursor: pointer; font-weight: bold; font-size: 0.95rem; }
  details p { font-size: 0.9rem; margin: 0.6rem 0 0.2rem; }

  @media (max-width: 46rem) {
    .controls { flex-direction: column; align-items: stretch; }
    .controls select { min-width: 0; }
    .result-zh { font-size: 1.7rem; }
  }
</style>
