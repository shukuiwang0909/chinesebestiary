---
import type { CollectionEntry } from 'astro:content';
import { getCreatureImage } from '../utils/creatureImage';
import { CATEGORY_LABELS } from '../utils/taxonomy';

interface Props {
  creature: CollectionEntry<'creatures'>;
}
const { creature } = Astro.props;
const d = creature.data;
const img = getCreatureImage(d.id);
---

<a class="card" href={`/creatures/${d.id}/`} data-category={d.taxonomy.category}>
  <div class="card-img-wrap">
    {img
      ? <img src={img} alt={`${d.name.en} (${d.name.zh_cn})`} loading="lazy" />
      : <span class="placeholder" aria-hidden="true">{d.name.zh_cn.slice(0, 1)}</span>}
  </div>
  <span class="names">
    <strong>{d.name.en}</strong>
    <span class="zh">{d.name.zh_cn}</span>
    <em>{d.name.pinyin}</em>
  </span>
  <span class="badge">{CATEGORY_LABELS[d.taxonomy.category]}</span>
</a>

<style>
  .card {
    display: flex; flex-direction: column; gap: 0.45rem;
    border: 1px solid #e0d9c8; background: #fff; padding: 0.8rem;
    text-decoration: none; color: var(--ink);
    border-radius: 4px;
    /* translate for hover; opacity for scroll reveal; box-shadow/border for hover */
    transition: translate 0.2s ease, opacity 0.35s ease, box-shadow 0.18s ease, border-color 0.18s ease;
    position: relative;
    overflow: hidden;
    /* scroll reveal: hidden by default, JS adds .in-view */
    opacity: 0;
    translate: 0 14px;
  }
  .card.in-view { opacity: 1; translate: 0 0; }
  .card::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0;
    height: 3px;
    background: var(--cat-color, var(--gold));
    opacity: 0;
    transition: opacity 0.18s ease;
  }
  .card:hover {
    translate: 0 -3px;
    box-shadow: 0 6px 20px rgba(26,26,46,0.12), 0 2px 6px rgba(184,147,61,0.15);
    border-color: var(--gold);
  }
  .card:hover::before { opacity: 1; }
  /* No-JS / reduced-motion fallback */
  @media (prefers-reduced-motion: reduce) {
    .card { opacity: 1; translate: 0 0; transition: box-shadow 0.18s, border-color 0.18s; }
    .card:hover { translate: 0 0; }
  }

  /* Category top-stripe colors */
  .card[data-category="divine_beast"]    { --cat-color: var(--cat-divine); }
  .card[data-category="fierce_beast"]    { --cat-color: var(--cat-fierce); }
  .card[data-category="auspicious_beast"]{ --cat-color: var(--cat-auspicious); }
  .card[data-category="deity"]           { --cat-color: var(--cat-deity); }
  .card[data-category="strange_being"]   { --cat-color: var(--cat-strange); }
  .card[data-category="hybrid"]          { --cat-color: var(--cat-hybrid); }

  .card-img-wrap {
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #f5f1e8;
    border: 1px solid #ede7d4;
    border-radius: 2px;
  }
  .card-img-wrap img { width: 100%; height: 100%; object-fit: contain; background: #fff; display: block; }
  .placeholder {
    display: flex; align-items: center; justify-content: center;
    width: 100%; height: 100%;
    font-size: clamp(2.5rem, 5vw, 4rem);
    color: var(--gold);
    font-family: "Noto Serif SC", serif;
    background: linear-gradient(135deg, #f5f1e8, #ede7d4);
  }
  .names { display: flex; flex-wrap: wrap; gap: 0.3rem; align-items: baseline; }
  .names strong { font-size: 0.9rem; line-height: 1.3; }
  .names .zh { font-size: 0.85rem; color: var(--mist); }
  .names em { color: #aaa; font-size: 0.78rem; }
  .badge {
    font-size: 0.72rem;
    color: var(--cat-color, var(--vermillion));
    font-weight: 600;
    letter-spacing: 0.02em;
  }
</style>
