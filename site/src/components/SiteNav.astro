---
import { NAV_ITEMS } from '../config/nav';

const items = NAV_ITEMS.filter(i => i.enabled !== false);
const path = Astro.url.pathname;

const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<nav class="site-nav" aria-label="Main">
  <input type="checkbox" id="nav-toggle" class="nav-toggle" />
  <label for="nav-toggle" class="nav-toggle-label" aria-label="Menu">
    <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <rect y="4" width="22" height="2" rx="1" fill="currentColor"/>
      <rect y="10" width="22" height="2" rx="1" fill="currentColor"/>
      <rect y="16" width="22" height="2" rx="1" fill="currentColor"/>
    </svg>
  </label>
  <ul class="nav-list">
    <li><a href="/" class:list={[{ active: isActive('/') }]}>Home</a></li>
    {items.map(item => (
      <li class:list={[{ 'has-children': item.children }]}>
        <a href={item.href} class:list={[{ active: isActive(item.href) }]}>{item.label}</a>
        {item.children && (
          <ul class="subnav">
            {item.children.map(child => (
              <li><a href={child.href} class:list={[{ active: isActive(child.href) }]}>{child.label}</a></li>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ul>
</nav>

<style>
  .site-nav { margin-top: 0.6rem; }
  .nav-toggle, .nav-toggle-label { display: none; }
  .nav-list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem 1.2rem; }
  .nav-list > li { position: relative; }
  .nav-list a { text-decoration: none; color: #555; font-size: 0.92rem; font-family: 'Cinzel', Georgia, serif; letter-spacing: 0.03em; transition: color 0.15s; }
  .nav-list a:hover { color: var(--vermillion); }
  .nav-list a.active { color: var(--vermillion); border-bottom: 2px solid var(--gold); padding-bottom: 2px; }
  .subnav {
    display: none; position: absolute; top: 100%; left: 0; z-index: 10;
    list-style: none; margin: 0.3rem 0 0; padding: 0.4rem 0.8rem;
    background: #fff; border: 1px solid #e0d9c8; min-width: 12rem;
    box-shadow: 2px 4px 12px rgba(26,26,46,0.1);
    border-radius: 3px;
  }
  .subnav li { margin: 0.25rem 0; }
  .subnav a { font-size: 0.85rem !important; font-family: Georgia, serif !important; letter-spacing: 0 !important; }
  .has-children:hover .subnav, .has-children:focus-within .subnav { display: block; }

  @media (max-width: 46rem) {
    .nav-toggle-label {
      display: flex; align-items: center; justify-content: center;
      width: 44px; height: 44px;
      cursor: pointer; color: var(--ink);
      border: 1px solid #e0d9c8; border-radius: 4px;
      background: #fff;
      user-select: none;
    }
    .nav-toggle-label:hover { border-color: var(--gold); color: var(--vermillion); }
    .nav-list { display: none; flex-direction: column; gap: 0.6rem; padding: 0.8rem 0 0.4rem; }
    .nav-toggle:checked ~ .nav-list { display: flex; }
    .subnav { display: block; position: static; border: none; box-shadow: none; padding-left: 1rem; margin: 0.2rem 0; background: transparent; }
    .nav-list a { font-size: 1rem; }
  }
</style>
