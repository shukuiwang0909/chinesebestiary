---
interface Props {
  title: string;
  description: string;
  image?: string;
}
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';

const { title, description, image } = Astro.props;
const ogImage = image ? new URL(image, Astro.site) : null;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={Astro.url.href} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="The Chinese Bestiary" />
  {ogImage && <meta property="og:image" content={ogImage.href} />}
  <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <style>
    :root {
      --ink: #1a1a2e;
      --paper: #faf8f3;
      --gold: #b8933d;
      --vermillion: #c0392b;
    }
    body {
      font-family: Georgia, 'Times New Roman', serif;
      background: var(--paper);
      color: var(--ink);
      max-width: 46rem;
      margin: 0 auto;
      padding: 2rem 1.5rem;
      line-height: 1.7;
    }
    header { border-bottom: 2px solid var(--gold); padding-bottom: 1rem; margin-bottom: 2rem; }
    header h1 { margin: 0; font-size: 1.4rem; }
    header h1 a { color: var(--ink); text-decoration: none; }
    .zh { font-family: "Noto Serif SC", "Songti SC", serif; }
  </style>
</head>
<body>
  <header>
    <h1><a href="/">The Chinese Bestiary <span class="zh">· 中国图鉴</span></a></h1>
    <SiteNav />
    <div id="search"></div>
  </header>
  <slot />
  <SiteFooter />
  <script src="/pagefind/pagefind-ui.js" is:inline></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
      new PagefindUI({ element: '#search', showSubResults: true });
    });
  </script>
</body>
</html>
