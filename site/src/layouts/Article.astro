---
import Base from './Base.astro';
import SubscribeBand from '../components/SubscribeBand.astro';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    image?: string;
    wide?: boolean;
    pubDate?: string | Date;
    updated?: string | Date;
  };
}

const { title, description, image, wide = false, pubDate, updated } = Astro.props.frontmatter;

const isoDate = (d?: string | Date) => d ? new Date(d).toISOString().slice(0, 10) : undefined;
const dateLabel = (d?: string | Date) => d
  ? new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })
  : undefined;
const pubIso = isoDate(pubDate);
const updIso = isoDate(updated);
const pubLabel = dateLabel(pubDate);
const updLabel = dateLabel(updated);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "inLanguage": "en",
  ...(pubIso && { "datePublished": pubIso }),
  ...(updIso && { "dateModified": updIso }),
  ...(image && { "image": `https://chinesebestiary.com${image}` }),
};
---

<Base title={title} description={description} image={image} wide={wide}>
  <article class="md-article">
    <h1>{title}</h1>
    <p class="article-meta">
      {pubLabel && <>Published {pubLabel}</>}{pubLabel && updLabel && <> · </>}{updLabel && <>Last updated {updLabel}</>}
    </p>
    <slot />
  </article>
  <SubscribeBand />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Base>

<style>
  .md-article :global(h1) {
    font-family: 'Cinzel', Georgia, serif;
    font-size: 1.6rem;
    line-height: 1.35;
    margin: 0 0 1.2rem;
  }
  .article-meta {
    font-size: 0.82rem;
    color: var(--mist);
    margin: -0.6rem 0 1.5rem;
  }
  .md-article :global(h2) {
    font-family: 'Cinzel', Georgia, serif;
    font-size: 1.45rem;
    margin: 0 0 0.4rem;
  }
  .md-article :global(h3) {
    font-family: 'Cinzel', Georgia, serif;
    font-size: 1.05rem;
    margin: 2rem 0 0.6rem;
    color: var(--ink);
    border-bottom: 1px solid #e0d9c8;
    padding-bottom: 0.3rem;
  }
  .md-article :global(table) {
    width: 100%; border-collapse: collapse; font-size: 0.88rem; margin: 0.8rem 0;
  }
  .md-article :global(th) {
    text-align: left; padding: 0.4rem 0.6rem; background: #f5f1e8;
    border-bottom: 2px solid var(--gold);
    font-family: 'Cinzel', Georgia, serif; font-size: 0.82rem;
  }
  .md-article :global(td) {
    padding: 0.4rem 0.6rem; border-bottom: 1px solid #e0d9c8; vertical-align: top;
  }
  .md-article :global(tr:last-child td) { border-bottom: none; }
  .md-article :global(blockquote) {
    border-left: 3px solid var(--gold);
    margin: 1rem 0;
    padding: 0.6rem 1rem;
    background: rgba(184,147,61,0.05);
    border-radius: 0 4px 4px 0;
  }
  .md-article :global(hr) {
    border: none; border-top: 1px solid #e0d9c8; margin: 2rem 0;
  }
</style>
